<Project>

  <PropertyGroup>

    <!-- Common Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Version Information -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>

    <!-- Package Metadata -->
    <Authors>Marco De Salvo</Authors>
    <Company>Marco De Salvo</Company>
    <Product>Ollamazing</Product>
    <Copyright>Marco De Salvo</Copyright>

    <!-- Repository Information -->
    <PackageProjectUrl>https://github.com/mdesalvo/Ollamazing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mdesalvo/Ollamazing.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseUrl>https://www.apache.org/licenses/LICENSE-2.0</PackageLicenseUrl>

    <!-- Common Description -->
    <Description>
    Ollamazing is a Blazor Server dashboard for Ollama: browse the ollama.com model
    catalog with faceted filters, pull models with live progress, start and stop the
    Ollama server, manage local models and link the server to an ollama.com account.
    </Description>

  </PropertyGroup>

</Project>
