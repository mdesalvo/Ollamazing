{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "WarmUpKeepAlive": "30m",
    "StatusPollSeconds": 3,
    "DeviceName": "Ollamazing"
  },
  "ServerControl": {
    "ExecutablePath": "ollama",
    "Environment": {},
    "StartOnLaunch": false,
    "StopOnExit": true,
    "LogFile": "",
    "LogLines": 200
  },
  "Catalog": {
    "BaseUrl": "https://ollama.com",
    "DatabasePath": "",
    "CacheTtlHours": 24,
    "MaxConcurrentRequests": 4,
    "MaxPages": 60
  }
}