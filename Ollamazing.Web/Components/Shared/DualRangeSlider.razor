@* Two-thumb slider over a discrete scale of steps, which Fluent UI does not offer; the parent owns the selected indexes. *@

<div class="dual-range @(Disabled ? "is-disabled" : "") @(IsLowOnTop ? "is-low-on-top" : "")">
    <div class="dual-range-track">
        <div class="dual-range-fill" style="left:@Percent(LowIndex)%; right:@(100 - Percent(HighIndex))%"></div>
    </div>
    <input class="dual-range-low" type="range" min="0" max="@MaxIndex" step="1" value="@LowIndex" disabled="@Disabled"
           aria-label="@($"{AriaLabel} from")" aria-valuetext="@ValueText(LowIndex)" @oninput="OnLowInput" />
    <input class="dual-range-high" type="range" min="0" max="@MaxIndex" step="1" value="@HighIndex" disabled="@Disabled"
           aria-label="@($"{AriaLabel} up to")" aria-valuetext="@ValueText(HighIndex)" @oninput="OnHighInput" />
</div>

@code {
    /// <summary>Index of the last step; the scale runs from 0 to this value.</summary>
    [Parameter, EditorRequired] public int MaxIndex { get; set; }

    [Parameter] public int LowIndex { get; set; }

    [Parameter] public int HighIndex { get; set; }

    /// <summary>Raised on every thumb movement with the new (low, high) pair, always ordered.</summary>
    [Parameter] public EventCallback<(int Low, int High)> RangeChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Name of the range for assistive technologies, such as "Memory size".</summary>
    [Parameter] public string AriaLabel { get; set; } = "Range";

    /// <summary>Spoken value of a step, such as "8 GB"; the bare index is read when absent.</summary>
    [Parameter] public Func<int, string>? StepLabel { get; set; }

    /// <summary>True when both thumbs sit at the end of the scale, where only the lower one can still move.</summary>
    private bool IsLowOnTop => LowIndex >= MaxIndex;

    /// <summary>Horizontal position of a step on the track, from 0 to 100.</summary>
    private double Percent(int index) => MaxIndex == 0 ? 0 : index * 100.0 / MaxIndex;

    private string ValueText(int index) => StepLabel?.Invoke(index) ?? index.ToString();

    /// <summary>Moves the lower bound; dragged past the upper one, it pushes the upper one along.</summary>
    private Task OnLowInput(ChangeEventArgs change)
    {
        int lowIndex = ReadIndex(change);
        return RangeChanged.InvokeAsync((lowIndex, Math.Max(lowIndex, HighIndex)));
    }

    /// <summary>Moves the upper bound; dragged below the lower one, it pushes the lower one along.</summary>
    private Task OnHighInput(ChangeEventArgs change)
    {
        int highIndex = ReadIndex(change);
        return RangeChanged.InvokeAsync((Math.Min(LowIndex, highIndex), highIndex));
    }

    /// <summary>Step chosen by a thumb, kept inside the scale whatever the browser reports.</summary>
    private int ReadIndex(ChangeEventArgs change)
        => int.TryParse(change.Value?.ToString(), out int index) ? Math.Clamp(index, 0, MaxIndex) : 0;
}
