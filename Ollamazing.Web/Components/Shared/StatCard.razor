@* One figure of a summary row, laid out as label, value and detail on every page. *@

@* Full height, so the figures of one row line up whatever each value is made of. *@
<FluentCard Height="100%">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="6px">
        <FluentText Size="TextSize.Size200" Weight="TextWeight.Semibold" Class="muted">@Label</FluentText>
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <FluentText Size="TextSize.Size500" Weight="TextWeight.Semibold">@Value</FluentText>
        }
        @if (Detail is not null)
        {
            <FluentText Size="TextSize.Size200" Class="muted">@Detail</FluentText>
        }
    </FluentStack>
</FluentCard>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>The figure itself; ignored when the value needs a component, given as child content.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Context of the figure, such as its unit, period or source.</summary>
    [Parameter] public string? Detail { get; set; }

    /// <summary>A value drawn by a component, such as a status badge, in place of the text value.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
