@inherits LayoutComponentBase
@implements IDisposable
@inject ServerStatusMonitor StatusMonitor
@inject PullManager PullManager
@inject AccountMonitor AccountMonitor
@inject IThemeService ThemeService
@inject NavigationManager Navigation

@* The page waits for the Ollamazing theme, so no control is ever seen in Fluent's default colours. *@
@if (isThemed)
{
    <FluentLayout>
        @*
            One brand bar: name on the left, the sections in the middle, server status and the account on the right.
            Every entry is a plain link, so navigation happens only on a click; the open section reads in white against the sky blue of the others.
        *@
        <FluentLayoutItem Area="LayoutArea.Header">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16px">
                <FluentText Size="TextSize.Size500" Weight="TextWeight.Semibold" Nowrap="true">🦙 Ollamazing</FluentText>
                <FluentSpacer />

                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="4px" Width="auto">
                    <FluentAnchorButton Href="server" Appearance="ButtonAppearance.Transparent" Color="@SectionColor("server")">Server</FluentAnchorButton>
                    <FluentAnchorButton Href="./" Appearance="ButtonAppearance.Transparent" Color="@SectionColor("")">Catalog</FluentAnchorButton>
                    <FluentAnchorButton Href="models" Appearance="ButtonAppearance.Transparent" Color="@SectionColor("models")">
                        Local models
                        @if (StatusMonitor.Current.IsReachable)
                        {
                            <FluentCounterBadge Count="StatusMonitor.Current.LocalModels.Count" ShowZero="true" Color="BadgeColor.Subtle" />
                        }
                    </FluentAnchorButton>
                    <FluentAnchorButton Href="downloads" Appearance="ButtonAppearance.Transparent" Color="@SectionColor("downloads")">
                        Downloads
                        @if (PullManager.ActiveCount > 0)
                        {
                            <FluentCounterBadge Count="PullManager.ActiveCount" Color="BadgeColor.Informative" />
                        }
                    </FluentAnchorButton>
                </FluentStack>

                <FluentSpacer />
                <FluentBadge Appearance="BadgeAppearance.Filled" Color="@StatusColor" Content="@StatusText" />
                <FluentAnchorButton Href="account" Appearance="ButtonAppearance.Transparent" Color="@SectionColor("account")" Title="@AccountTooltip">
                    Account
                    @if (AccountMonitor.Current is { } account)
                    {
                        <FluentCounterBadge Dot="true" Color="@(account.IsSignedIn ? BadgeColor.Success : BadgeColor.Warning)" />
                    }
                </FluentAnchorButton>
            </FluentStack>
        </FluentLayoutItem>

        <FluentLayoutItem Area="LayoutArea.Content" Padding="@Padding.All6">
            @Body
        </FluentLayoutItem>
    </FluentLayout>

    <FluentProviders />
}

@code {
    /// <summary>Seed of the Fluent colour ramp: a calm light blue, from which Fluent derives every brand shade.</summary>
    private const string BrandSeed = "#4aa3df";

    /// <summary>Text colour of the entries of the brand bar: the seed lightened to a sky blue that still reads on the bar.</summary>
    private const string OnBrandText = $"color-mix(in srgb, {BrandSeed} 62%, white)";

    /// <summary>Text colour of the entry of the page on screen: plain white, the brightest tone the bar can carry.</summary>
    private const string OpenSectionText = "var(--colorNeutralForegroundOnBrand)";

    /// <summary>True once the Ollamazing theme is applied, so the page may be shown.</summary>
    private bool isThemed;

    /// <summary>Route of the page on screen, relative to the base address and without query string.</summary>
    private string CurrentRoute => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    /// <summary>Label colour of an entry: white for the page on screen, so the bar shows where the user is.</summary>
    private string SectionColor(string route) => route == CurrentRoute ? OpenSectionText : OnBrandText;

    /// <summary>Colour of the server badge: checking, reachable, process up but API silent, or down.</summary>
    private BadgeColor StatusColor => StatusMonitor.Current switch
    {
        // The first probe has not answered yet.
        { IsInitial: true } => BadgeColor.Subtle,
        // The API answers, so every page works.
        { IsReachable: true } => BadgeColor.Success,
        // The process exists but the API is silent, typically while it starts.
        { Process.IsRunning: true } => BadgeColor.Warning,
        // Nothing is running.
        _ => BadgeColor.Danger
    };

    /// <summary>Label of the server badge, with the version once the API answers.</summary>
    private string StatusText => StatusMonitor.Current switch
    {
        // The first probe has not answered yet.
        { IsInitial: true } => "Checking Ollama…",
        // The version tells which Ollama the dashboard drives.
        { IsReachable: true } current => $"Ollama {current.Version}",
        // The process exists but the API is silent.
        { Process.IsRunning: true } => "Ollama starting…",
        // Nothing is running.
        _ => "Ollama offline"
    };

    /// <summary>Tooltip of the account entry: who cloud requests are billed to, or that no account is linked.</summary>
    private string AccountTooltip => AccountMonitor.Current switch
    {
        // A linked account is named, so a wrong account is noticed at a glance.
        { User.Name: { } userName } => $"Linked to ollama.com as {userName}",
        // A reachable server without a linked key cannot run paid cloud models.
        { IsSignedIn: false } => "No ollama.com account linked",
        // Unknown while the server is down or not checked yet.
        _ => "ollama.com account"
    };

    protected override void OnInitialized()
    {
        // The header badges follow the server status, the download queue and the linked account.
        StatusMonitor.Changed += Rerender;
        PullManager.Changed += Rerender;
        AccountMonitor.Changed += Rerender;

        // The outlined entry follows the page on screen, including links followed from inside a page.
        Navigation.LocationChanged += OnLocationChanged;
    }

    /// <summary>Redraws the header when the page changes, so the outlined entry matches it.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs location) => Rerender();

    /// <summary>Grows the Fluent colour ramp from the Ollamazing seed, always in dark mode.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The theme is applied once per circuit.
        if (!firstRender)
            return;

        // The seed is not imposed as is: Fluent picks the shades of its ramp, so white text on brand surfaces stays readable.
        await ThemeService.SetThemeAsync(new ThemeSettings(BrandSeed, 0, 0, ThemeMode.Dark, false));
        isThemed = true;
        StateHasChanged();
    }

    /// <summary>Marshals a background notification onto the circuit dispatcher.</summary>
    private void Rerender() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        StatusMonitor.Changed -= Rerender;
        PullManager.Changed -= Rerender;
        AccountMonitor.Changed -= Rerender;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
