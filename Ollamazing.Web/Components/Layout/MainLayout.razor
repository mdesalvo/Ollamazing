@inherits LayoutComponentBase
@implements IDisposable
@inject ServerStatusMonitor StatusMonitor
@inject PullManager PullManager
@inject AccountMonitor AccountMonitor

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">🦙</span>
            <span class="brand-name">Ollamazing</span>
        </a>

        <nav class="nav">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Catalog</NavLink>
            <NavLink class="nav-link" href="models">
                Local models
                @if (StatusMonitor.Current.IsReachable)
                {
                    <span class="nav-count">@StatusMonitor.Current.LocalModels.Count</span>
                }
            </NavLink>
            <NavLink class="nav-link" href="downloads">
                Downloads
                @if (PullManager.ActiveCount > 0)
                {
                    <span class="nav-count is-accent">@PullManager.ActiveCount</span>
                }
            </NavLink>
            <NavLink class="nav-link" href="server">Server</NavLink>
            <NavLink class="nav-link" href="account" title="@AccountTitle">
                Account
                @if (AccountMonitor.Current is { } account)
                {
                    <span class="status-dot @(account.IsSignedIn ? "is-up" : "is-warning")"></span>
                }
            </NavLink>
        </nav>

        <a class="server-pill" href="server" title="Checked @Display.Relative(StatusMonitor.Current.CheckedAt)">
            <span class="status-dot @StatusClass"></span>
            <span>@StatusText</span>
        </a>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    /// <summary>Colour of the status dot: checking, reachable, process up but API silent, or down.</summary>
    private string StatusClass => StatusMonitor.Current switch
    {
        { IsInitial: true } => "is-unknown",
        { IsReachable: true } => "is-up",
        { Process.IsRunning: true } => "is-warning",
        _ => "is-down"
    };

    private string StatusText => StatusMonitor.Current switch
    {
        { IsInitial: true } => "Checking Ollama…",
        { IsReachable: true } current => $"Ollama {current.Version}",
        { Process.IsRunning: true } => "Ollama starting…",
        _ => "Ollama offline"
    };

    /// <summary>Tooltip of the account entry: who cloud requests are billed to, or that no account is linked.</summary>
    private string AccountTitle => AccountMonitor.Current switch
    {
        // A linked account is named, so a wrong account is noticed at a glance.
        { User.Name: { } userName } => $"Linked to ollama.com as {userName}",
        // A reachable server without a linked key cannot run paid cloud models.
        { IsSignedIn: false } => "No ollama.com account linked",
        // Unknown while the server is down or not checked yet.
        _ => "ollama.com account"
    };

    protected override void OnInitialized()
    {
        // The sidebar badges follow the server status, the download queue and the linked account.
        StatusMonitor.Changed += Rerender;
        PullManager.Changed += Rerender;
        AccountMonitor.Changed += Rerender;
    }

    /// <summary>Marshals a background notification onto the circuit dispatcher.</summary>
    private void Rerender() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        StatusMonitor.Changed -= Rerender;
        PullManager.Changed -= Rerender;
        AccountMonitor.Changed -= Rerender;
    }
}
