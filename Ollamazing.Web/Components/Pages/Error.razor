@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<PageHeader Title="Error">
    <Subtitle>An error occurred while processing your request.</Subtitle>
</PageHeader>

@if (ShowRequestId)
{
    <FluentText As="TextTag.Paragraph">Request ID: <FluentText Font="TextFont.Monospace">@RequestId</FluentText></FluentText>
}

<FluentMessageBar Intent="MessageBarIntent.Info" Title="Development mode">
    The Development environment shows detailed information about the error, but it must not be enabled for deployed applications:
    it can reveal sensitive information from exceptions. For local debugging, set ASPNETCORE_ENVIRONMENT to Development and restart the app.
</FluentMessageBar>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
