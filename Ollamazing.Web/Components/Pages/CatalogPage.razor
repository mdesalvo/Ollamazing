@page "/"
@using System.Globalization
@inherits LiveComponentBase
@inject CatalogService CatalogService
@inject PullManager PullManager
@inject ServerStatusMonitor StatusMonitor

<PageTitle>Catalog · Ollamazing</PageTitle>

<PageHeader Title="Model catalog">
    <Subtitle>@CatalogStatusLine</Subtitle>
    <Actions>
        <FluentButton Loading="@CatalogService.IsRefreshing" OnClick="RefreshCatalog">Refresh catalog</FluentButton>
    </Actions>
</PageHeader>

@if (CatalogService.LastError is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Margin="@Margin.Bottom4">Catalog refresh failed: @CatalogService.LastError</FluentMessageBar>
}
@if (!StatusMonitor.Current.IsReachable && !StatusMonitor.Current.IsInitial)
{
    <FluentMessageBar Intent="MessageBarIntent.Warning" Margin="@Margin.Bottom4">
        Ollama is offline: browsing works, downloads need the server. <FluentLink Href="server">Open the server panel</FluentLink>
    </FluentMessageBar>
}

@{
    // Facets and results are computed once per render and shared by the panel, the counters and the list.
    allModels = CatalogService.Models;
    facets = query.BuildFacets(allModels);
    IReadOnlyList<CatalogModel> matchingModels = SortModels(allModels.Where(model => query.Matches(model, facets))).ToList();
    int modelsAwaitingSizes = query.CountAwaitingSizes(allModels, facets);
}

<FluentGrid Spacing="4">
    <FluentGridItem Xs="12" Md="3" Lg="2" HiddenWhen="GridItemHidden.SmAndDown">
        <SectionCard Title="Filters">
            <Actions>
                @if (query.HasSelections || query.IsSizeRangeActive || query.IsPriceRangeActive || query.SearchText.Length > 0)
                {
                    <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="ClearAllFilters">Clear all</FluentButton>
                }
            </Actions>
            <ChildContent>
            @FilterControls
            </ChildContent>
        </SectionCard>
    </FluentGridItem>

    <FluentGridItem Xs="12" HiddenWhen="GridItemHidden.MdAndUp">
        <FluentAccordion>
            <FluentAccordionItem Header="@FiltersHeader">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                    @if (query.HasSelections || query.IsSizeRangeActive || query.IsPriceRangeActive || query.SearchText.Length > 0)
                    {
                        <FluentStack Orientation="Orientation.Horizontal">
                            <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="ClearAllFilters">Clear all</FluentButton>
                        </FluentStack>
                    }
                    @FilterControls
                </FluentStack>
            </FluentAccordionItem>
        </FluentAccordion>
    </FluentGridItem>

    <FluentGridItem Xs="12" Md="9" Lg="10">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px" VerticalAlignment="VerticalAlignment.Bottom">
                <FluentTextInput Appearance="TextInputAppearance.FilledDarker" TextInputType="TextInputType.Search" Placeholder="Search by name or description…" Immediate="true" Width="100%"
                                 Value="@query.SearchText" ValueChanged="SetSearchText" AriaLabel="Search the catalog" />
                <FluentSelect Appearance="ListAppearance.FilledDarker" TOption="SortOrder" TValue="SortOrder" Items="SortOrders" OptionText="SortLabel" OptionValue="order => order"
                              Value="sortOrder" ValueChanged="ChangeSortOrder" Width="200px" AriaLabel="Sort by" />
            </FluentStack>

            <FluentText Size="TextSize.Size200" Class="muted">
                @matchingModels.Count of @allModels.Count models@(modelsAwaitingSizes > 0 ? $" · {modelsAwaitingSizes} more may match once their sizes are loaded" : "")
            </FluentText>

            @foreach (CatalogModel model in matchingModels.Take(visibleCount))
            {
                bool isExpanded = expandedModels.Contains(model.Name);
                int installedCount = InstalledTagCount(model);
                <FluentCard>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10px">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px" Wrap="true">
                            <FluentLink Href="@($"https://ollama.com/library/{model.Name}")" Target="LinkTarget.Blank" ReferrerPolicy="LinkReferrerPolicy.NoReferrer">
                                <FluentText Size="TextSize.Size400" Weight="TextWeight.Semibold">@model.Name</FluentText>
                            </FluentLink>
                            @if (model.IsNew)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Brand" Content="new" />
                            }
                            @if (model.OffersCloud)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative" Content="cloud" />
                            }
                            @if (model.IsCloudFree)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Content="free" />
                            }
                            @if (model.HasPaidOption && model.CloudUsageLevel > 0)
                            {
                                <FluentText Weight="TextWeight.Bold" Tooltip="Cloud usage cost">@(new string('$', model.CloudUsageLevel))<FluentText Class="faint">@(new string('$', 4 - model.CloudUsageLevel))</FluentText></FluentText>
                            }
                            @foreach (string capability in model.Capabilities)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Subtle" Content="@capability" />
                            }
                            @foreach (string parameterSize in model.ParameterSizes)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Outline" Color="BadgeColor.Subtle" Content="@parameterSize" />
                            }
                            @if (installedCount > 0)
                            {
                                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand" Content="@InstalledLabel(installedCount)" />
                            }
                            <FluentSpacer />
                            @if (FindActivePull(model) is { } activeJob)
                            {
                                <PullProgress Job="activeJob" />
                            }
                            else
                            {
                                <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!StatusMonitor.Current.IsReachable)" OnClick="() => PullDefaultAsync(model)"
                                              Title="@(model.TagsLoadedAt is null ? $"Pull {model.Name}" : $"Pull {model.DefaultPullReference}")">Pull</FluentButton>
                            }
                        </FluentStack>

                        <FluentText>@model.Description</FluentText>

                        @if (model.Prices.Count > 0)
                        {
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
                                <FluentText Size="TextSize.Size200" Weight="TextWeight.Semibold" Class="muted" Tooltip="@CatalogService.PricingNote">Cloud pricing · per 1M tokens</FluentText>
                                <FluentDataGrid Items="model.Prices.AsQueryable()" RowSize="DataGridRowSize.Small" GridTemplateColumns="1fr 1fr 1fr 1fr" Style="max-width: 560px;">
                                    <TemplateColumn Title="Rate">@PriceLabel(context)</TemplateColumn>
                                    <TemplateColumn Title="Input" Align="DataGridCellAlignment.End">@Display.Price(context.Input)</TemplateColumn>
                                    <TemplateColumn Title="Cached input" Align="DataGridCellAlignment.End">@Display.Price(context.CachedInput)</TemplateColumn>
                                    <TemplateColumn Title="Output" Align="DataGridCellAlignment.End">@Display.Price(context.Output)</TemplateColumn>
                                </FluentDataGrid>
                            </FluentStack>
                        }

                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16px" Wrap="true">
                            @if (model.Downloads is { } downloads)
                            {
                                <FluentText Size="TextSize.Size200" Class="muted">@Display.Count(downloads) pulls</FluentText>
                            }
                            @if (model.UpdatedOn is { } updatedOn)
                            {
                                <FluentText Size="TextSize.Size200" Class="muted">updated @Display.Relative(updatedOn.ToDateTime(TimeOnly.MinValue))</FluentText>
                            }
                            @if (model.ContextWindow is not null)
                            {
                                <FluentText Size="TextSize.Size200" Class="muted">@model.ContextWindow context</FluentText>
                            }
                            <FluentText Size="TextSize.Size200" Class="muted">@SizeSummary(model)</FluentText>
                            <FluentSpacer />
                            <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="() => ToggleExpandedAsync(model)">
                                @(isExpanded ? "Hide tags" : model.TagsLoadedAt is null ? "Show tags" : $"Show {TagCount(model.Tags.Count)}")
                            </FluentButton>
                            <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="() => ToggleUsage(model)">@(modelsShowingUsage.Contains(model.Name) ? "Hide usage" : "Use this model")</FluentButton>
                        </FluentStack>

                        @if (isExpanded)
                        {
                            @if (model.TagsLoadedAt is null)
                            {
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" VerticalAlignment="VerticalAlignment.Center">
                                    <FluentSpinner Size="SpinnerSize.Tiny" />
                                    <FluentText Class="muted">Loading tags…</FluentText>
                                </FluentStack>
                            }
                            else
                            {
                                List<CatalogTag> visibleTags = VisibleTags(model).ToList();
                                <FluentDataGrid Items="visibleTags.AsQueryable()" RowSize="DataGridRowSize.Small" GridTemplateColumns="2fr 1fr 1fr 1fr 220px">
                                    <TemplateColumn Title="Tag">
                                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6px" VerticalAlignment="VerticalAlignment.Center">
                                            <FluentText>@context.TagName</FluentText>
                                            @if (context.IsLatest)
                                            {
                                                <FluentBadge Size="BadgeSize.Small" Appearance="BadgeAppearance.Tint" Color="BadgeColor.Subtle" Content="latest" />
                                            }
                                            @if (context.IsCloud)
                                            {
                                                <FluentBadge Size="BadgeSize.Small" Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative" Content="cloud" />
                                            }
                                        </FluentStack>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Size">
                                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6px" VerticalAlignment="VerticalAlignment.Center">
                                            @{ MemoryFit? memoryFit = MemoryFitOf(context); }
                                            <FluentText Tooltip="@memoryFit?.Hint">@Display.Bytes(context.SizeBytes)</FluentText>
                                            @if (memoryFit is not null)
                                            {
                                                <FluentBadge Size="BadgeSize.Small" Appearance="BadgeAppearance.Tint" Color="@memoryFit.Color" Content="@memoryFit.Label" />
                                            }
                                        </FluentStack>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Context">@context.ContextWindow</TemplateColumn>
                                    <TemplateColumn Title="Input">@context.Inputs</TemplateColumn>
                                    <TemplateColumn Title="" Align="DataGridCellAlignment.End">
                                        @if (PullManager.FindActive(context.FullName) is { } tagJob)
                                        {
                                            <PullProgress Job="tagJob" />
                                        }
                                        else if (InstalledNames.Contains(context.FullName))
                                        {
                                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand" Content="installed" />
                                        }
                                        else
                                        {
                                            <FluentButton Size="ButtonSize.Small" Disabled="@(!StatusMonitor.Current.IsReachable)" OnClick="() => PullManager.StartPull(context.FullName)">Pull</FluentButton>
                                        }
                                    </TemplateColumn>
                                </FluentDataGrid>
                                @if (model.Tags.Count > visibleTags.Count)
                                {
                                    <FluentStack Orientation="Orientation.Horizontal">
                                        <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="() => modelsShowingAllTags.Add(model.Name)">
                                            Show @TagCount(model.Tags.Count - visibleTags.Count) outside the current filters
                                        </FluentButton>
                                    </FluentStack>
                                }
                            }
                        }

                        @if (modelsShowingUsage.Contains(model.Name))
                        {
                            <UsageSnippets ModelReference="@model.DefaultPullReference" IsEmbedding="@IsEmbedding(model)" />
                        }
                    </FluentStack>
                </FluentCard>
            }

            @if (matchingModels.Count > visibleCount)
            {
                <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="() => visibleCount += PageSize">Show more (@(matchingModels.Count - visibleCount) left)</FluentButton>
                </FluentStack>
            }
        </FluentStack>
    </FluentGridItem>
</FluentGrid>

@code {
    /// <summary>The facets and the size range, shared by the side panel and the collapsible panel of narrow windows.</summary>
    private RenderFragment FilterControls => @<text>
        @foreach (Facet facet in facets)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                    <FluentText Size="TextSize.Size300" Weight="TextWeight.Semibold">@facet.Title</FluentText>
                    <FluentSpacer />
                    @if (query.HasSelectionsIn(facet.Key))
                    {
                        <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="() => ClearFacet(facet)">Clear</FluentButton>
                    }
                </FluentStack>
                @foreach (FacetOption option in facet.Options)
                {
                    int optionCount = query.CountOption(allModels, facets, facet, option);
                    bool isSelected = query.IsSelected(facet.Key, option.Key);
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                        <FluentCheckbox Label="@option.Label" Value="isSelected" Disabled="@(optionCount == 0 && !isSelected)"
                                        ValueChanged="(bool _) => ToggleOption(facet, option)" />
                        <FluentSpacer />
                        <FluentText Size="TextSize.Size200" Class="muted">@optionCount</FluentText>
                    </FluentStack>
                }
            </FluentStack>
            <FluentDivider />
        }

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
            <FluentText Size="TextSize.Size300" Weight="TextWeight.Semibold">Memory size</FluentText>
            <FluentText Weight="TextWeight.Semibold">@SizeStepLabel(sizeLowIndex) – @SizeStepLabel(sizeHighIndex)</FluentText>
            <DualRangeSlider MaxIndex="SizeStepsInGigabytes.Length - 1" LowIndex="sizeLowIndex" HighIndex="sizeHighIndex"
                             RangeChanged="SetSizeRange" Disabled="query.IsCloudOnly" AriaLabel="Memory size" StepLabel="SizeStepLabel" />
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4px" Wrap="true">
                <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" Disabled="query.IsCloudOnly" OnClick="FitToMachineMemory"
                              Title="Limit to models with a tag that fits in the memory of this machine">Fit to my RAM (@Display.Bytes(MachineMemoryBytes))</FluentButton>
                @if (query.IsSizeRangeActive)
                {
                    <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="ResetSizeRange">Clear size limit</FluentButton>
                }
            </FluentStack>
            @if (query.IsCloudOnly)
            {
                <FluentText Size="TextSize.Size200" Class="muted">Cloud models run on ollama.com and need no local memory.</FluentText>
            }
        </FluentStack>

        <FluentDivider />

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
            <FluentText Size="TextSize.Size300" Weight="TextWeight.Semibold">Price per 1M tokens</FluentText>

            <FluentText>Input · @PriceStepLabel(inputPriceLowIndex) – @PriceStepLabel(inputPriceHighIndex)</FluentText>
            <DualRangeSlider MaxIndex="PriceStepsInDollars.Length - 1" LowIndex="inputPriceLowIndex" HighIndex="inputPriceHighIndex"
                             RangeChanged="SetInputPriceRange" Disabled="query.IsLocalOnly" AriaLabel="Input price" StepLabel="PriceStepLabel" />

            <FluentText>Output · @PriceStepLabel(outputPriceLowIndex) – @PriceStepLabel(outputPriceHighIndex)</FluentText>
            <DualRangeSlider MaxIndex="PriceStepsInDollars.Length - 1" LowIndex="outputPriceLowIndex" HighIndex="outputPriceHighIndex"
                             RangeChanged="SetOutputPriceRange" Disabled="query.IsLocalOnly" AriaLabel="Output price" StepLabel="PriceStepLabel" />

            @if (query.IsPriceRangeActive && !query.IsLocalOnly)
            {
                <FluentText Size="TextSize.Size200" Class="muted">Only models with pay-as-you-go cloud rates are shown.</FluentText>
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="ResetPriceRanges">Clear price limit</FluentButton>
                </FluentStack>
            }
            @if (query.IsLocalOnly)
            {
                <FluentText Size="TextSize.Size200" Class="muted">Local models run on this machine and have no token rates.</FluentText>
            }
        </FluentStack>
    </text>;

    /// <summary>Title of the collapsible filter panel, counting the active filters so they stay visible while it is closed.</summary>
    private string FiltersHeader
    {
        get
        {
            // The size range and the price ranges count as one filter each however far they are narrowed.
            int activeFilters = query.SelectionCount + (query.IsSizeRangeActive ? 1 : 0) + (query.IsPriceRangeActive ? 1 : 0);

            // Without active filters the title stays plain.
            return activeFilters == 0 ? "Filters" : $"Filters ({activeFilters} active)";
        }
    }

    /// <summary>Number of cards rendered per "show more" step, keeping each SignalR render diff small.</summary>
    private const int PageSize = 40;

    /// <summary>Bytes in one gigabyte, decimal as ollama.com prints model sizes.</summary>
    private const double BytesPerGigabyte = 1e9;

    /// <summary>Steps of the price sliders in dollars per million tokens, covering the rates published on ollama.com.</summary>
    private static readonly double[] PriceStepsInDollars = [0, 0.05, 0.1, 0.25, 0.5, 1, 2, 5, 10, 20, double.PositiveInfinity];

    /// <summary>Slider scale in GB, denser at the small end where consumer hardware lives; the last step means "no limit".</summary>
    private static readonly double[] SizeStepsInGigabytes = [0, 0.5, 1, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192, 256, 512, double.PositiveInfinity];

    /// <summary>Physical memory available to this process, the reference for the "fits my RAM" shortcut.</summary>
    private static readonly long MachineMemoryBytes = GC.GetGCMemoryInfo().TotalAvailableMemoryBytes;

    /// <summary>How a downloadable tag compares with the memory of this machine, as a badge colour, a word and the share it needs.</summary>
    private sealed record MemoryFit(BadgeColor Color, string Label, string Hint);

    /// <summary>Share of the machine memory up to which a tag runs comfortably, leaving room for the context and the system.</summary>
    private const double ComfortableMemoryShare = 0.7;

    /// <summary>Compares a tag with the machine memory; null for cloud tags, which run on ollama.com.</summary>
    private static MemoryFit? MemoryFitOf(CatalogTag tag)
    {
        // Cloud tags have no weights to hold in memory.
        if (tag.SizeBytes is not { } sizeBytes)
            return null;

        // Fraction of the machine memory that the weights alone occupy.
        double memoryShare = (double)sizeBytes / MachineMemoryBytes;

        // The size tooltip puts the badge in figures, so the user sees how close to the limit the tag is.
        string hint = $"Needs about {memoryShare.ToString("P0", CultureInfo.InvariantCulture)} of the {Display.Bytes(MachineMemoryBytes)} of memory of this machine";
        // The share of memory decides the verdict; anything above the whole memory is too large.
        return memoryShare switch
        {
            // Room is left for the context window and for everything else running.
            <= ComfortableMemoryShare => new MemoryFit(BadgeColor.Success, "fits", hint),
            // It loads, but a long context or other applications may push it out of memory.
            <= 1 => new MemoryFit(BadgeColor.Warning, "tight", hint),
            // The weights alone exceed the memory of this machine.
            _ => new MemoryFit(BadgeColor.Danger, "too large", hint)
        };
    }

    /// <summary>Orderings the catalog list can take.</summary>
    private enum SortOrder { Popular, Newest, Downloads, Smallest, Name }

    /// <summary>Orders offered by the sort selector, most useful first.</summary>
    private static readonly SortOrder[] SortOrders = Enum.GetValues<SortOrder>();

    /// <summary>Facet selections, search text and ranges chosen by the user.</summary>
    private readonly CatalogQuery query = new();

    /// <summary>Catalog snapshot of the current render, read by the filter controls.</summary>
    private IReadOnlyList<CatalogModel> allModels = [];

    /// <summary>Facets built from <see cref="allModels"/> in the current render, read by the filter controls.</summary>
    private IReadOnlyList<Facet> facets = [];

    /// <summary>Ordering chosen in the sort selector.</summary>
    private SortOrder sortOrder = SortOrder.Popular;

    /// <summary>Slider position of the lower bound of the memory size range, as an index into <see cref="SizeStepsInGigabytes"/>.</summary>
    private int sizeLowIndex;

    /// <summary>Slider position of the upper bound of the memory size range, as an index into <see cref="SizeStepsInGigabytes"/>.</summary>
    private int sizeHighIndex = SizeStepsInGigabytes.Length - 1;

    /// <summary>Slider positions of the input price range, as indexes into <see cref="PriceStepsInDollars"/>.</summary>
    private int inputPriceLowIndex;
    private int inputPriceHighIndex = PriceStepsInDollars.Length - 1;

    /// <summary>Slider positions of the output price range, as indexes into <see cref="PriceStepsInDollars"/>.</summary>
    private int outputPriceLowIndex;
    private int outputPriceHighIndex = PriceStepsInDollars.Length - 1;

    /// <summary>Number of cards currently rendered, raised by the "show more" button.</summary>
    private int visibleCount = PageSize;

    /// <summary>Models whose tag table is open.</summary>
    private readonly HashSet<string> expandedModels = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Models whose "Use this model" snippets are open.</summary>
    private readonly HashSet<string> modelsShowingUsage = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Expanded models whose tag table ignores the filters, after the user asked to see every tag.</summary>
    private readonly HashSet<string> modelsShowingAllTags = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Subscribes the page to the notifications that change what it shows.</summary>
    protected override void OnInitialized()
    {
        // Catalog progress, download progress and the installed list all change what the page shows.
        Watch(handler => CatalogService.Changed += handler, handler => CatalogService.Changed -= handler);
        Watch(handler => PullManager.Changed += handler, handler => PullManager.Changed -= handler);
        Watch(handler => StatusMonitor.Changed += handler, handler => StatusMonitor.Changed -= handler);
    }

    /// <summary>Full references of the installed models, used to flag tags already on the server.</summary>
    private HashSet<string> InstalledNames =>
        // References are compared without case so a tag matches however it was typed.
        StatusMonitor.Current.LocalModels.Select(model => model.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);

    /// <summary>One-line state of the catalog under the page title.</summary>
    private string CatalogStatusLine
    {
        get
        {
            // Before the first refresh there is nothing to describe yet.
            if (CatalogService.RefreshedAt is not { } refreshedAt)
                return CatalogService.IsRefreshing ? "Reading the catalog from ollama.com…" : "Catalog not loaded yet";

            // The base line gives size and age of the catalog; the counter measures how many models already have their sizes.
            string line = $"{CatalogService.Models.Count} models from ollama.com, refreshed {Display.Relative(refreshedAt)}";
            int modelsWithTags = CatalogService.ModelsWithTags;

            // Sizes arrive progressively; the counter tells why the size facet may still be incomplete.
            return modelsWithTags < CatalogService.Models.Count
                ? $"{line} · loading sizes {modelsWithTags}/{CatalogService.Models.Count}"
                : line;
        }
    }

    /// <summary>Orders the matching models; ties keep the popularity order of ollama.com.</summary>
    private IEnumerable<CatalogModel> SortModels(IEnumerable<CatalogModel> models) => sortOrder switch
    {
        // Popularity is the native order of the catalog.
        SortOrder.Popular => models.OrderBy(model => model.PopularityRank),
        // Unknown update dates sink to the bottom.
        SortOrder.Newest => models.OrderByDescending(model => model.UpdatedOn ?? DateOnly.MinValue),
        // Cloud-only models have no counter and sink to the bottom.
        SortOrder.Downloads => models.OrderByDescending(model => model.Downloads ?? -1),
        // Models are ranked by their smallest local tag; unknown sizes sink to the bottom.
        SortOrder.Smallest => models.OrderBy(model => model.LocalTags.Select(tag => tag.SizeBytes ?? long.MaxValue).DefaultIfEmpty(long.MaxValue).Min()),
        // Alphabetical order ignores case.
        _ => models.OrderBy(model => model.Name, StringComparer.OrdinalIgnoreCase)
    };

    /// <summary>Tags shown in the expanded table, narrowed by class and size range unless the user asked for all of them.</summary>
    private IEnumerable<CatalogTag> VisibleTags(CatalogModel model)
    {
        // The explicit request to see every tag wins over any filter.
        if (modelsShowingAllTags.Contains(model.Name))
            return model.Tags;

        // Cloud tags are shown when the cloud class is selected or no class is; local tags likewise.
        bool showsLocal = query.IsSelected(CatalogQuery.ClassFacetKey, CatalogQuery.LocalOptionKey) || !query.IsSelected(CatalogQuery.ClassFacetKey, CatalogQuery.CloudOptionKey);
        bool showsCloud = query.IsSelected(CatalogQuery.ClassFacetKey, CatalogQuery.CloudOptionKey) || !query.IsSelected(CatalogQuery.ClassFacetKey, CatalogQuery.LocalOptionKey);

        // Local tags must also fall inside the size range, when one is set.
        return model.Tags.Where(tag => tag.IsCloud
            ? showsCloud
            : showsLocal && (!query.IsSizeRangeActive || query.IsInSizeRange(tag)));
    }

    /// <summary>Range of download sizes of a model, the quickest hint of the hardware it needs.</summary>
    private static string SizeSummary(CatalogModel model)
    {
        // Sizes are known only after the tags page has been read.
        if (model.TagsLoadedAt is null)
            return model.OffersLocal ? "size loading…" : "cloud only";

        // Download sizes of the local tags, which are the only ones with weights.
        List<long> sizes = model.LocalTags.Select(tag => tag.SizeBytes!.Value).ToList();

        // Cloud-only models have no downloadable weights.
        if (sizes.Count == 0)
            return "cloud only";

        // A single size is shown alone; a spread is shown as the range between the smallest and the largest tag.
        long smallest = sizes.Min();
        long largest = sizes.Max();
        return smallest == largest ? Display.Bytes(smallest) : $"{Display.Bytes(smallest)} – {Display.Bytes(largest)}";
    }

    /// <summary>Names a pricing row by the tag it is restricted to and by its time band, as in "120b" or "off-peak".</summary>
    private static string PriceLabel(CatalogPrice price) => (price.Variant, price.IsOffPeak) switch
    {
        // A tag-specific off-peak rate needs both qualifiers.
        ({ } variant, true) => $"{variant} · off-peak",
        // A tag-specific rate applies at any time.
        ({ } variant, false) => variant,
        // The discounted band of a model-wide rate.
        (null, true) => "off-peak",
        // The model-wide rate, which is the peak rate when an off-peak one exists.
        (null, false) => "standard"
    };

    /// <summary>Badge text for installed tags, counting them when more than one is on the server.</summary>
    private static string InstalledLabel(int installedCount) =>
        // The count is worth showing only when several tags of the model are installed.
        installedCount > 1 ? $"installed ×{installedCount}" : "installed";

    /// <summary>Number of tags of a model already installed on the server.</summary>
    private int InstalledTagCount(CatalogModel model) =>
        // Installed references are "name:tag", so the prefix with the colon avoids matching models whose name merely starts the same.
        StatusMonitor.Current.LocalModels.Count(installed => installed.Name.StartsWith(model.Name + ":", StringComparison.OrdinalIgnoreCase));

    /// <summary>Running download started from the card's quick button, if any.</summary>
    private PullJob? FindActivePull(CatalogModel model) =>
        // The quick button pulls the default reference, but a pull started by the bare name counts too.
        PullManager.FindActive(model.DefaultPullReference) ?? PullManager.FindActive(model.Name);

    /// <summary>Label of a slider step: sub-gigabyte steps in MB, the last one as unlimited.</summary>
    private static string SizeStepLabel(int index) => SizeStepsInGigabytes[index] switch
    {
        // The last step means no limit.
        double.PositiveInfinity => "∞",
        // The first step is the empty lower bound.
        0 => "0",
        // Steps below one gigabyte read better in megabytes.
        < 1 and var gigabytes => $"{gigabytes * 1000:0} MB",
        // Every other step is a whole number of gigabytes.
        var gigabytes => $"{gigabytes:0} GB"
    };

    /// <summary>Label of a price slider step: the last one as unlimited.</summary>
    private static string PriceStepLabel(int index) =>
        // The unbounded step carries no price.
        double.IsPositiveInfinity(PriceStepsInDollars[index]) ? "∞" : Display.Price((decimal)PriceStepsInDollars[index]);

    /// <summary>Price in dollars of a slider step; the last step means no upper bound.</summary>
    private static decimal PriceStepValue(int index) =>
        // The unbounded step becomes the largest decimal so no model is excluded by its rates.
        double.IsPositiveInfinity(PriceStepsInDollars[index]) ? decimal.MaxValue : (decimal)PriceStepsInDollars[index];

    /// <summary>Returns the list to its first page of cards.</summary>
    private void ResetPaging() =>
        // A changed filter or order makes the previous scroll depth meaningless.
        visibleCount = PageSize;

    /// <summary>Flips one option of a facet in the query and restarts paging.</summary>
    private void ToggleOption(Facet facet, FacetOption option)
    {
        // The option joins or leaves the selection of its facet.
        query.Toggle(facet.Key, option.Key);
        // The result list changed, so it restarts from its first page.
        ResetPaging();
    }

    /// <summary>Deselects every option of one facet and restarts paging so the list refreshes as after a single toggle.</summary>
    private void ClearFacet(Facet facet)
    {
        // Only this facet is emptied; the other facets and the search text stay.
        query.ClearSelections(facet.Key);
        ResetPaging();
    }

    /// <summary>Applies the text typed in the search box to the query and restarts paging.</summary>
    private void SetSearchText(string? searchText)
    {
        // Surrounding blanks never belong to a model name; an empty box means no text filter.
        query.SearchText = searchText?.Trim() ?? "";
        ResetPaging();
    }

    /// <summary>Applies the ordering chosen in the selector and restarts paging.</summary>
    private void ChangeSortOrder(SortOrder order)
    {
        // The list is re-sorted at the next render.
        sortOrder = order;
        ResetPaging();
    }

    /// <summary>Label of a sort order in the selector.</summary>
    private static string SortLabel(SortOrder order) => order switch
    {
        // Popularity is the native order of ollama.com.
        SortOrder.Popular => "Most popular",
        // Recent updates first.
        SortOrder.Newest => "Recently updated",
        // Download counters, highest first.
        SortOrder.Downloads => "Most pulled",
        // Smallest local tag first.
        SortOrder.Smallest => "Smallest size",
        // Alphabetical.
        _ => "Name"
    };

    /// <summary>Applies a slider movement to the query; the last step of the scale removes the upper bound.</summary>
    private void SetSizeRange((int Low, int High) range)
    {
        // The sliders keep the chosen positions so they stay where the user left them.
        (sizeLowIndex, sizeHighIndex) = range;

        // The lower bound converts the step to bytes; the last step of the scale means no upper bound.
        query.MinSizeBytes = (long)(SizeStepsInGigabytes[sizeLowIndex] * BytesPerGigabyte);
        query.MaxSizeBytes = double.IsPositiveInfinity(SizeStepsInGigabytes[sizeHighIndex])
            ? long.MaxValue
            : (long)(SizeStepsInGigabytes[sizeHighIndex] * BytesPerGigabyte);
        ResetPaging();
    }

    /// <summary>Opens the memory size range to the whole scale.</summary>
    private void ResetSizeRange() =>
        // The full scale from the first to the last step filters nothing out.
        SetSizeRange((0, SizeStepsInGigabytes.Length - 1));

    /// <summary>Applies a movement of the input price slider to the query; the last step removes the upper bound.</summary>
    private void SetInputPriceRange((int Low, int High) range)
    {
        // The sliders keep the chosen positions; the query receives the dollar value of each step.
        (inputPriceLowIndex, inputPriceHighIndex) = range;
        query.MinInputPrice = PriceStepValue(inputPriceLowIndex);
        query.MaxInputPrice = PriceStepValue(inputPriceHighIndex);
        ResetPaging();
    }

    /// <summary>Applies a movement of the output price slider to the query; the last step removes the upper bound.</summary>
    private void SetOutputPriceRange((int Low, int High) range)
    {
        // The sliders keep the chosen positions; the query receives the dollar value of each step.
        (outputPriceLowIndex, outputPriceHighIndex) = range;
        query.MinOutputPrice = PriceStepValue(outputPriceLowIndex);
        query.MaxOutputPrice = PriceStepValue(outputPriceHighIndex);
        ResetPaging();
    }

    /// <summary>Opens both price ranges, so models are no longer filtered by their rates.</summary>
    private void ResetPriceRanges()
    {
        // Both sliders return to the full scale, which filters nothing out.
        SetInputPriceRange((0, PriceStepsInDollars.Length - 1));
        SetOutputPriceRange((0, PriceStepsInDollars.Length - 1));
    }

    /// <summary>Caps the size range at the largest step that fits in the machine memory.</summary>
    private void FitToMachineMemory()
    {
        // The last finite step not exceeding the physical memory becomes the upper bound.
        double memoryInGigabytes = MachineMemoryBytes / BytesPerGigabyte;
        int fittingIndex = Array.FindLastIndex(SizeStepsInGigabytes, step => step <= memoryInGigabytes);

        // The index never drops below the second step, so a machine smaller than every step still leaves a non-empty range.
        SetSizeRange((0, Math.Max(fittingIndex, 1)));
    }

    /// <summary>Removes every selection, the search text and both kinds of range.</summary>
    private void ClearAllFilters()
    {
        // Facet selections and search text are emptied; the ranges are opened to their whole scales.
        query.ClearSelections();
        query.SearchText = "";
        ResetSizeRange();
        ResetPriceRanges();
    }

    /// <summary>A count of tags with the noun agreeing, as in "1 tag" or "8 tags".</summary>
    private static string TagCount(int count) =>
        // Only one takes the singular noun.
        count == 1 ? "1 tag" : $"{count} tags";

    /// <summary>Opens or closes the "Use this model" snippets of a model.</summary>
    private void ToggleUsage(CatalogModel model)
    {
        // A name already present means the snippets are open, so the click closes them.
        if (!modelsShowingUsage.Add(model.Name))
            modelsShowingUsage.Remove(model.Name);
    }

    /// <summary>True when the model computes embeddings instead of generating text.</summary>
    private static bool IsEmbedding(CatalogModel model) =>
        // Ollama announces embedding models through their capability list.
        model.Capabilities.Contains("embedding", StringComparer.OrdinalIgnoreCase);

    /// <summary>Opens or closes the tag table, loading the tags page on demand when the background load has not reached it.</summary>
    private async Task ToggleExpandedAsync(CatalogModel model)
    {
        // Closing needs no data.
        if (!expandedModels.Add(model.Name))
        {
            expandedModels.Remove(model.Name);
            return;
        }

        // Opening needs the tag table, which is read now if the background load has not reached this model.
        await CatalogService.EnsureTagsAsync(model.Name);
    }

    /// <summary>Pulls the default tag of a model, reading its tags first so cloud-only models resolve to their cloud tag.</summary>
    private async Task PullDefaultAsync(CatalogModel model)
    {
        // The default reference depends on the tags, which may not be loaded yet for this model.
        await CatalogService.EnsureTagsAsync(model.Name);
        // The model as it is after loading, because the tags change which reference is the default.
        CatalogModel currentModel = CatalogService.Models.FirstOrDefault(candidate => candidate.Name == model.Name) ?? model;
        // The download is queued under the default reference.
        PullManager.StartPull(currentModel.DefaultPullReference);
    }

    /// <summary>Starts a catalog refresh detached from this circuit; progress reaches every open page through change events.</summary>
    private void RefreshCatalog() =>
        // The refresh outlives the circuit of the click, so it does not stop when the user leaves the page.
        _ = Task.Run(() => CatalogService.RefreshAsync());
}
