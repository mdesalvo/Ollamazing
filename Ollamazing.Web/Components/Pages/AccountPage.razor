@page "/account"
@inherits LiveComponentBase
@inject AccountMonitor AccountMonitor
@inject ServerStatusMonitor StatusMonitor
@inject OllamaServerController ServerController
@inject IOllamaApiClient OllamaClient

<PageTitle>Account · Ollamazing</PageTitle>

@{
    ServerStatus serverStatus = StatusMonitor.Current;
    AccountStatus? account = AccountMonitor.Current;
}

<PageHeader Title="ollama.com account">
    <Subtitle>Cloud models run on ollama.com and are billed to the account linked to this server.</Subtitle>
    <Actions>
        @if (account is { IsSignedIn: true })
        {
            <FluentButton Loading="isLoadingAccountData" OnClick="LoadAccountDataAsync">Refresh</FluentButton>
            @if (isConfirmingSignOut)
            {
                <FluentButton Appearance="ButtonAppearance.Primary" Loading="isSigningOut" OnClick="SignOutAsync"
                              Title="Revokes the key of this server on ollama.com: cloud models stop until the account is linked again">Confirm sign out</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="isSigningOut" OnClick="CancelSignOut">Cancel</FluentButton>
            }
            else
            {
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="AskSignOut">Sign out</FluentButton>
            }
        }
    </Actions>
</PageHeader>

@if (actionError is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Margin="@Margin.Bottom4">@actionError</FluentMessageBar>
}

@if (serverStatus.IsInitial)
{
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" VerticalAlignment="VerticalAlignment.Center">
        <FluentSpinner Size="SpinnerSize.Tiny" />
        <FluentText Class="muted">Checking Ollama…</FluentText>
    </FluentStack>
}
else if (!serverStatus.IsReachable)
{
    <SectionCard Title="The Ollama server is not running">
        <FluentText Class="muted">
            The account is linked to the key of the local server, so linking it and reading its credits need the server running.
        </FluentText>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
            <FluentButton Appearance="ButtonAppearance.Primary" Loading="@(isStartingServer || serverStatus.Process.IsRunning)" OnClick="StartServerAsync">Start server</FluentButton>
            <FluentAnchorButton Href="server" Appearance="ButtonAppearance.Subtle">Server panel</FluentAnchorButton>
        </FluentStack>
    </SectionCard>
}
else if (account is null)
{
    @if (AccountMonitor.LastError is { } accountError)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">
            <ChildContent>The server could not reach ollama.com: @accountError</ChildContent>
            <ActionsTemplate><FluentButton Size="ButtonSize.Small" OnClick="RetryAccountCheckAsync">Retry</FluentButton></ActionsTemplate>
        </FluentMessageBar>
    }
    else
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" VerticalAlignment="VerticalAlignment.Center">
            <FluentSpinner Size="SpinnerSize.Tiny" />
            <FluentText Class="muted">Checking the account…</FluentText>
        </FluentStack>
    }
}
else if (!account.IsSignedIn)
{
    <SectionCard Title="Link your ollama.com account">
        <FluentText Class="muted">
            Linking authorizes the key of this server on ollama.com: cloud models then run under your account,
            drawing on its plan allowance and purchased credits. Your password never passes through Ollamazing.
        </FluentText>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px">
                <FluentBadge Shape="BadgeShape.Circular" Appearance="BadgeAppearance.Filled" Color="BadgeColor.Brand" Content="1" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="2px">
                    <FluentText Weight="TextWeight.Semibold">Open ollama.com</FluentText>
                    <FluentText Class="muted">Sign in there if asked. This server is listed as <FluentText Font="TextFont.Monospace">@(account.DeviceName ?? "this computer")</FluentText>.</FluentText>
                </FluentStack>
            </FluentStack>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px">
                <FluentBadge Shape="BadgeShape.Circular" Appearance="BadgeAppearance.Filled" Color="BadgeColor.Brand" Content="2" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="2px">
                    <FluentText Weight="TextWeight.Semibold">Approve the connection</FluentText>
                    <FluentText Class="muted">Confirm on the page that opens in a new tab.</FluentText>
                    @if (account.KeyFingerprint is { } keyFingerprint)
                    {
                        <FluentText Size="TextSize.Size200" Class="muted">
                            Key being linked: <FluentText Font="TextFont.Monospace" Size="TextSize.Size200">@keyFingerprint</FluentText>. It must match the key ollama.com shows for this device.
                        </FluentText>
                    }
                </FluentStack>
            </FluentStack>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px">
                <FluentBadge Shape="BadgeShape.Circular" Appearance="BadgeAppearance.Filled" Color="BadgeColor.Brand" Content="3" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="2px">
                    <FluentText Weight="TextWeight.Semibold">Back to Ollamazing</FluentText>
                    <FluentText Class="muted">The approval is detected automatically; there is nothing to copy or paste.</FluentText>
                </FluentStack>
            </FluentStack>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16px" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
            <FluentAnchorButton Href="@account.SignInUrl" Target="LinkTarget.Blank" ReferrerPolicy="LinkReferrerPolicy.NoReferrer" Appearance="ButtonAppearance.Primary">Link account on ollama.com</FluentAnchorButton>
            @if (isWaitingForApproval)
            {
                <FluentSpinner Size="SpinnerSize.Tiny" />
                <FluentText Class="muted">Waiting for the approval on ollama.com…</FluentText>
            }
        </FluentStack>

        @if (hasPairingTimedOut)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning">
                <ChildContent>No approval arrived within @((int)PairingTimeout.TotalMinutes) minutes, so Ollamazing stopped checking.</ChildContent>
                <ActionsTemplate><FluentButton Size="ButtonSize.Small" OnClick="WaitForApprovalAgain">Check again</FluentButton></ActionsTemplate>
            </FluentMessageBar>
        }
    </SectionCard>
}
else
{
    UserResponse user = account.User!;
    UsageTotals? usageTotals = usage?.Totals;

    @if (hasJustPaired)
    {
        <FluentMessageBar Intent="MessageBarIntent.Success" Margin="@Margin.Bottom4">Account linked: cloud models now run as @user.Name.</FluentMessageBar>
    }
    @if (accountDataError is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" Margin="@Margin.Bottom4">@accountDataError</FluentMessageBar>
    }

    <FluentCard Margin="@Margin.Bottom4">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16px" VerticalAlignment="VerticalAlignment.Center">
            <FluentAvatar Image="@SecureImage(user.AvatarUrl)" Name="@DisplayName(user)" Size="AvatarSize.Size48" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="2px" Width="auto">
                <FluentText Size="TextSize.Size400" Weight="TextWeight.Semibold">@DisplayName(user)</FluentText>
                <FluentText Size="TextSize.Size200" Class="muted">@user.Name · @user.Email</FluentText>
            </FluentStack>
            <FluentSpacer />
            @if (!string.IsNullOrEmpty(user.Plan))
            {
                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand" Content="@($"{user.Plan} plan")" />
            }
        </FluentStack>
    </FluentCard>

    <FluentGrid Spacing="3">
        <FluentGridItem Xs="12" Md="4">
            <StatCard Label="Purchased credits" Value="@(balance?.Purchased is { } purchased ? Display.Price(purchased.BalanceUsd) : "–")"
                      Detail="spent once the plan allowance runs out" />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="4">
            <StatCard Label="Plan allowance" Value="@AllowanceSummary"
                      Detail="@(balance?.Included?.Period is { } period ? $"renews {Display.Relative(period.Until)}" : "left in this period")" />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="4">
            <StatCard Label="@($"Spent · last {RangeLabel(usageRange)}")" Value="@(usageTotals is null ? "–" : Display.Price(usageTotals.UsageUsd))"
                      Detail="@(usageTotals is null ? "loading…" : $"{usageTotals.RequestCount:N0} cloud requests")" />
        </FluentGridItem>
    </FluentGrid>

    <SectionCard Title="Cloud usage" Margin="@Margin.Top4">
        <Actions>
            <FluentRadioGroup TValue="string" Value="@usageRange" ValueChanged="ChangeUsageRangeAsync" Orientation="Orientation.Horizontal"
                              Disabled="isLoadingAccountData" AriaLabel="Usage range">
                @foreach (string range in UsageRanges)
                {
                    <FluentRadio TValue="string" Value="@range" Label="@range" />
                }
            </FluentRadioGroup>
        </Actions>
        <ChildContent>

        @if (usageTotals is null)
        {
            <FluentText Class="muted">@(isLoadingAccountData ? "Loading usage…" : "Usage is not available.")</FluentText>
        }
        else if (usageTotals.Groups.Count == 0)
        {
            <FluentText Class="muted">No cloud requests in the last @RangeLabel(usageRange).</FluentText>
        }
        else
        {
            <FluentDataGrid Items="UsageByModel(usageTotals)" GridTemplateColumns="2fr 1fr 1fr 1fr 1fr 1fr">
                <TemplateColumn Title="Model"><FluentText Font="TextFont.Monospace">@context.Model</FluentText></TemplateColumn>
                <TemplateColumn Title="Requests" Align="DataGridCellAlignment.End">@context.RequestCount.ToString("N0")</TemplateColumn>
                <TemplateColumn Title="Input" Align="DataGridCellAlignment.End">@Display.Count(context.InputTokens)</TemplateColumn>
                <TemplateColumn Title="Cached input" Align="DataGridCellAlignment.End">@Display.Count(context.CachedInputTokens)</TemplateColumn>
                <TemplateColumn Title="Output" Align="DataGridCellAlignment.End">@Display.Count(context.OutputTokens)</TemplateColumn>
                <TemplateColumn Title="Cost" Align="DataGridCellAlignment.End">@Display.Price(context.UsageUsd)</TemplateColumn>
            </FluentDataGrid>
            @if (usageTotals.Groups.Count > 1)
            {
                <FluentText Size="TextSize.Size200" Class="muted">
                    Total: @usageTotals.RequestCount.ToString("N0") requests · @Display.Count(usageTotals.InputTokens) input · @Display.Count(usageTotals.CachedInputTokens) cached · @Display.Count(usageTotals.OutputTokens) output · @Display.Price(usageTotals.UsageUsd)
                </FluentText>
            }
        }
        </ChildContent>
    </SectionCard>
}

@code {
    /// <summary>Delay between two account checks while the user approves the link on ollama.com.</summary>
    private static readonly TimeSpan PairingPollInterval = TimeSpan.FromSeconds(3);

    /// <summary>How long the page waits for the approval before giving up, so an abandoned tab stops polling.</summary>
    private static readonly TimeSpan PairingTimeout = TimeSpan.FromMinutes(10);

    /// <summary>Ranges accepted by the usage endpoint of ollama.com.</summary>
    private static readonly string[] UsageRanges = ["24h", "7d", "30d"];

    /// <summary>Stops the approval polling when the account gets linked or the user leaves the page.</summary>
    private CancellationTokenSource? pairingCancellation;

    /// <summary>True while the page checks for the approval, which it does as long as the pairing screen is open.</summary>
    private bool isWaitingForApproval;

    private bool hasPairingTimedOut;

    /// <summary>True after a link approved while this page was waiting, to confirm the outcome above the account details.</summary>
    private bool hasJustPaired;

    private bool isStartingServer;

    /// <summary>A second click is required because signing out revokes the server key on ollama.com and stops every cloud model.</summary>
    private bool isConfirmingSignOut;

    private bool isSigningOut;

    /// <summary>Failure of a user action (start, sign out), shown at the top of the page.</summary>
    private string? actionError;

    private BalanceResponse? balance;
    private UsageResponse? usage;
    private string usageRange = "7d";
    private bool isLoadingAccountData;
    private string? accountDataError;

    /// <summary>Account whose credits and usage are on screen, so a different account triggers a fresh load.</summary>
    private string? loadedAccountId;

    /// <summary>Remaining plan allowance over the whole allowance of the period, as in "$0.00 of $0.00".</summary>
    private string AllowanceSummary => balance?.Included is { } included
        ? $"{Display.Price(included.BalanceUsd)} of {Display.Price(included.AllowanceUsd)}"
        : "–";

    protected override async Task OnInitializedAsync()
    {
        // Account and server status both decide which screen is shown.
        Watch(handler => AccountMonitor.Changed += handler, handler => AccountMonitor.Changed -= handler);
        Watch(handler => StatusMonitor.Changed += handler, handler => StatusMonitor.Changed -= handler);
        AccountMonitor.Changed += OnAccountChanged;

        // A page opened before any check asks right away instead of waiting for the next server restart.
        if (AccountMonitor.Current is null && StatusMonitor.Current.IsReachable)
            await AccountMonitor.RefreshAsync();

        // A linked account shows its credits, an unlinked one starts waiting for the approval.
        await SyncWithAccountAsync();
    }

    public override void Dispose()
    {
        AccountMonitor.Changed -= OnAccountChanged;
        pairingCancellation?.Cancel();
        pairingCancellation?.Dispose();
        base.Dispose();
    }

    /// <summary>Follows account changes made anywhere, such as an approval detected by the polling or a sign-out in another tab.</summary>
    private void OnAccountChanged() => _ = InvokeAsync(SyncWithAccountAsync);

    /// <summary>Loads the credits of a newly linked account, drops those of an account no longer linked and waits for an approval.</summary>
    private async Task SyncWithAccountAsync()
    {
        // An unlinked server keeps the page checking for the approval, so the link is detected without a click.
        if (AccountMonitor.Current is { IsSignedIn: false } && !isWaitingForApproval && !hasPairingTimedOut)
            _ = InvokeAsync(WaitForApprovalAsync);

        string? accountId = AccountMonitor.Current?.User?.Id;

        // An unchanged account keeps the figures already on screen.
        if (accountId == loadedAccountId)
            return;

        loadedAccountId = accountId;
        balance = null;
        usage = null;
        accountDataError = null;

        // A signed-out or unknown account has no credits to read.
        if (accountId is null)
        {
            StateHasChanged();
            return;
        }

        await LoadAccountDataAsync();
    }

    /// <summary>Reads balance and usage of the linked account in parallel.</summary>
    private async Task LoadAccountDataAsync()
    {
        isLoadingAccountData = true;
        accountDataError = null;
        StateHasChanged();
        try
        {
            // Both figures come from ollama.com through the server, so they are requested together.
            Task<BalanceResponse> balanceTask = OllamaClient.GetBalanceAsync();
            Task<UsageResponse> usageTask = OllamaClient.GetUsageAsync(usageRange);
            balance = await balanceTask;
            usage = await usageTask;
        }
        catch (Exception loadError) when (loadError is HttpRequestException or TaskCanceledException)
        {
            // The account stays linked; only its figures are missing until the next refresh.
            accountDataError = $"Reading credits and usage failed: {loadError.Message}";
        }
        finally
        {
            isLoadingAccountData = false;
        }
        StateHasChanged();
    }

    /// <summary>Switches the usage table to another range; the balance does not depend on it.</summary>
    private async Task ChangeUsageRangeAsync(string? range)
    {
        // Only the ranges ollama.com accepts are applied.
        if (range is null || !UsageRanges.Contains(range))
            return;
        usageRange = range;
        await LoadAccountDataAsync();
    }

    /// <summary>Usage rows ordered by cost, then by number of requests, so the models that spend the credits come first.</summary>
    private static IQueryable<ModelUsage> UsageByModel(UsageTotals usageTotals)
        => usageTotals.Groups.OrderByDescending(group => group.UsageUsd).ThenByDescending(group => group.RequestCount).AsQueryable();

    /// <summary>Polls the server until the account is linked, the deadline passes or the user leaves the page.</summary>
    private async Task WaitForApprovalAsync()
    {
        // A fresh deadline starts with every wait.
        pairingCancellation?.Dispose();
        pairingCancellation = new CancellationTokenSource(PairingTimeout);
        CancellationToken pairingToken = pairingCancellation.Token;

        // The waiting indicator appears and any outcome of a previous wait is cleared.
        isWaitingForApproval = true;
        hasPairingTimedOut = false;
        StateHasChanged();
        try
        {
            // Each check is published to every circuit, so the approval also updates the header and other tabs.
            using PeriodicTimer pollTimer = new(PairingPollInterval);
            while (await pollTimer.WaitForNextTickAsync(pairingToken))
            {
                await AccountMonitor.RefreshAsync(pairingToken);

                // The approval ends the wait; the account details replace the pairing screen.
                if (AccountMonitor.Current is { IsSignedIn: true })
                {
                    hasJustPaired = true;
                    return;
                }
            }
        }
        catch (OperationCanceledException) when (pairingToken.IsCancellationRequested)
        {
            // The deadline is reported with a way to resume; a page being closed has no one left to tell.
            hasPairingTimedOut = true;
        }
        finally
        {
            isWaitingForApproval = false;
            StateHasChanged();
        }
    }

    /// <summary>Resumes the checks after the deadline, for an approval that took longer than expected.</summary>
    private Task WaitForApprovalAgain() => WaitForApprovalAsync();

    /// <summary>Asks the server for the account again after ollama.com could not be reached.</summary>
    private Task RetryAccountCheckAsync() => AccountMonitor.RefreshAsync();

    /// <summary>Starts the server from this page, since linking cannot happen without it.</summary>
    private async Task StartServerAsync()
    {
        isStartingServer = true;
        actionError = null;

        // Starting waits on the process, so it runs off the circuit thread.
        ServerActionResult result = await Task.Run(() => ServerController.Execute(ServerAction.Start));

        // A failed start explains itself; a successful one is followed by the account check once the API answers.
        if (!result.Succeeded)
            actionError = result.Message;
        await StatusMonitor.ProbeNowAsync();
        isStartingServer = false;
    }

    private void AskSignOut() => isConfirmingSignOut = true;

    private void CancelSignOut() => isConfirmingSignOut = false;

    /// <summary>Unlinks the account after confirmation; the pairing screen comes back with a fresh link.</summary>
    private async Task SignOutAsync()
    {
        isSigningOut = true;
        actionError = null;
        try
        {
            await AccountMonitor.SignOutAsync();
            hasJustPaired = false;
        }
        catch (Exception signOutError) when (signOutError is HttpRequestException or TaskCanceledException)
        {
            // The account is still linked and stays on screen.
            actionError = $"Sign out failed: {signOutError.Message}";
        }
        finally
        {
            isSigningOut = false;
            isConfirmingSignOut = false;
        }
    }

    /// <summary>Avatar address when served over HTTPS; anything else is dropped, so the profile picture cannot downgrade the page.</summary>
    private static string? SecureImage(string? imageUrl)
        => Uri.TryCreate(imageUrl, UriKind.Absolute, out Uri? imageUri) && imageUri.Scheme == Uri.UriSchemeHttps ? imageUrl : null;

    /// <summary>Full name from the profile, falling back to the user name when the profile has none.</summary>
    private static string DisplayName(UserResponse user)
    {
        string fullName = $"{user.FirstName} {user.LastName}".Trim();
        return fullName.Length > 0 ? fullName : user.Name ?? "ollama.com user";
    }

    /// <summary>Spells out a usage range for sentences such as "last 7 days".</summary>
    private static string RangeLabel(string range) => range switch
    {
        // The hourly range reads better in hours.
        "24h" => "24 hours",
        // The daily ranges keep their day count.
        "7d" => "7 days",
        "30d" => "30 days",
        // An unknown range is shown as ollama.com names it.
        _ => range
    };
}
