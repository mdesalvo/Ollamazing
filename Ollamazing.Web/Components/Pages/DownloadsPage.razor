@page "/downloads"
@inherits LiveComponentBase
@inject PullManager PullManager
@inject ServerStatusMonitor StatusMonitor

<PageTitle>Downloads · Ollamazing</PageTitle>

<PageHeader Title="Downloads">
    <Subtitle>@(PullManager.ActiveCount > 0 ? $"{PullManager.ActiveCount} running · downloads continue when you leave this page" : "Downloads continue when you leave this page")</Subtitle>
    <Actions>
        @if (PullManager.Jobs.Any(job => !job.IsActive))
        {
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="PullManager.ClearFinished">Clear finished</FluentButton>
        }
    </Actions>
</PageHeader>

@if (!StatusMonitor.Current.IsReachable && !StatusMonitor.Current.IsInitial)
{
    <ServerOfflineCard Reason="Models are downloaded by the Ollama server, so it has to be running to pull one." Margin="@Margin.Bottom4" />
}
else
{
<SectionCard Title="Pull a model by reference" Margin="@Margin.Bottom4">
    <form @onsubmit="PullTypedReference">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px">
            <FluentTextInput Appearance="TextInputAppearance.FilledDarker" @bind-Value="typedReference" Immediate="true" Width="100%"
                             Placeholder="e.g. qwen3:8b or gpt-oss:120b-cloud" AriaLabel="Model reference" />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary"
                          Disabled="@(!StatusMonitor.Current.IsReachable || string.IsNullOrWhiteSpace(typedReference))">Pull</FluentButton>
        </FluentStack>
    </form>
</SectionCard>
}

@if (PullManager.Jobs.Count == 0)
{
    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="12px">
            <FluentText>No downloads yet.</FluentText>
            <FluentAnchorButton Href="./" Appearance="ButtonAppearance.Primary">Browse the catalog</FluentAnchorButton>
        </FluentStack>
    </FluentCard>
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
    @foreach (PullJob job in PullManager.Jobs)
    {
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px" Wrap="true">
                    <FluentText Weight="TextWeight.Semibold">@job.ModelReference</FluentText>
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="@StateColor(job.State)" Content="@job.State.ToString().ToLowerInvariant()" />
                    <FluentSpacer />
                    <FluentText Size="TextSize.Size200" Class="muted">started @Display.Relative(job.StartedAt)</FluentText>
                    @if (job.IsActive)
                    {
                        <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="() => PullManager.Cancel(job.Id)">Cancel</FluentButton>
                    }
                    else if (job.State is PullState.Failed or PullState.Cancelled)
                    {
                        <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" Disabled="@(!StatusMonitor.Current.IsReachable)" OnClick="() => PullManager.StartPull(job.ModelReference)">Retry</FluentButton>
                    }
                </FluentStack>

                @if (job.IsActive)
                {
                    <PullProgress Job="job" />
                    @if (job.LastProgress is { Total: > 0 } progress)
                    {
                        <FluentText Size="TextSize.Size200" Class="muted">@progress.Status · @Display.Bytes(progress.Completed) of @Display.Bytes(progress.Total)</FluentText>
                    }
                }
                else if (job.Error is not null)
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error">@job.Error</FluentMessageBar>
                }
                else if (job.FinishedAt is { } finishedAt)
                {
                    <FluentText Size="TextSize.Size200" Class="muted">Finished @Display.Relative(finishedAt) in @Display.Duration(finishedAt - job.StartedAt)</FluentText>
                }
            </FluentStack>
        </FluentCard>
    }
</FluentStack>

@code {
    private string? typedReference = "";

    protected override void OnInitialized()
    {
        // Progress comes from the pulls, reachability from the status probe.
        Watch(handler => PullManager.Changed += handler, handler => PullManager.Changed -= handler);
        Watch(handler => StatusMonitor.Changed += handler, handler => StatusMonitor.Changed -= handler);
    }

    /// <summary>Badge colour of a download: brand while running, then the colour of its outcome.</summary>
    private static BadgeColor StateColor(PullState state) => state switch
    {
        // A running pull carries the accent.
        PullState.Running => BadgeColor.Brand,
        // A finished pull is good news.
        PullState.Completed => BadgeColor.Success,
        // A failed pull needs attention.
        PullState.Failed => BadgeColor.Danger,
        // A cancelled pull is neutral.
        _ => BadgeColor.Subtle
    };

    /// <summary>Starts a pull for a reference typed by hand, for models outside the official catalog (user namespaces, private registries).</summary>
    private void PullTypedReference()
    {
        // Blank input has nothing to pull.
        if (string.IsNullOrWhiteSpace(typedReference))
            return;
        PullManager.StartPull(typedReference.Trim());
        typedReference = "";
    }
}
