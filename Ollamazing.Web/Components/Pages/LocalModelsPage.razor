@page "/models"
@using System.Globalization
@inherits LiveComponentBase
@inject IOllamaApiClient OllamaClient
@inject ServerStatusMonitor StatusMonitor
@inject PullManager PullManager
@inject IOptions<OllamaOptions> OllamaOptions

<PageTitle>Local models · Ollamazing</PageTitle>

@{
    // Installed and resident models come from the shared status probe, so every tab sees the same list.
    ServerStatus status = StatusMonitor.Current;
    Dictionary<string, RunningModel> runningByName = status.RunningModels.ToDictionary(model => model.Name, StringComparer.OrdinalIgnoreCase);
    List<Model> visibleModels = status.LocalModels
        .Where(model => string.IsNullOrEmpty(filterText) || model.Name.Contains(filterText, StringComparison.OrdinalIgnoreCase))
        .ToList();
}

@if (status.IsReachable)
{
    <PageHeader Title="Local models">
        <Subtitle>@status.LocalModels.Count installed · @Display.Bytes(status.LocalModels.Where(model => !model.IsCloud()).Sum(model => model.Size)) on disk · @status.RunningModels.Count in memory</Subtitle>
        <Actions>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="RefreshAsync">Refresh</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" Disabled="@(status.LocalModels.Count == 0)" OnClick="UpdateAll"
                          Title="Pull every installed model again; only changed layers are downloaded">Update all</FluentButton>
        </Actions>
    </PageHeader>
}
else
{
    @* Counts and actions are unknown until the server answers. *@
    <PageHeader Title="Local models" />
}

@if (!status.IsReachable && !status.IsInitial)
{
    <ServerOfflineCard Reason="Installed models are listed by the Ollama server, so it has to be running to show them." />
}
@if (failure is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Margin="@Margin.Bottom4">
        <ChildContent>@failure</ChildContent>
        <ActionsTemplate><FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="DismissFailure">Dismiss</FluentButton></ActionsTemplate>
    </FluentMessageBar>
}

@if (status.LocalModels.Count > 0)
{
    <FluentTextInput Appearance="TextInputAppearance.FilledDarker" TextInputType="TextInputType.Search" Placeholder="Filter installed models…" Immediate="true" Width="100%"
                     @bind-Value="filterText" AriaLabel="Filter installed models" Margin="@Margin.Bottom4" />

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
        @foreach (Model model in visibleModels)
        {
            bool isCloud = model.IsCloud();
            RunningModel? runningModel = runningByName.GetValueOrDefault(model.Name);
            <FluentCard>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10px">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px" Wrap="true">
                        <FluentText Size="TextSize.Size400" Weight="TextWeight.Semibold" Nowrap="true">@model.Name</FluentText>
                        @if (isCloud)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative" Content="cloud" />
                        }
                        @if (runningModel is not null)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand" Content="in memory" />
                        }
                        @if (!string.IsNullOrEmpty(model.Details?.Family))
                        {
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Subtle" Content="@model.Details.Family" />
                        }
                        @if (!string.IsNullOrEmpty(model.Details?.ParameterSize))
                        {
                            <FluentBadge Appearance="BadgeAppearance.Outline" Color="BadgeColor.Subtle" Content="@model.Details.ParameterSize" />
                        }
                        @if (!string.IsNullOrEmpty(model.Details?.QuantizationLevel))
                        {
                            <FluentBadge Appearance="BadgeAppearance.Outline" Color="BadgeColor.Subtle" Content="@model.Details.QuantizationLevel" />
                        }
                        <FluentSpacer />
                        @if (busyOperations.GetValueOrDefault(model.Name) is { } busyOperation)
                        {
                            <FluentText Class="muted">@busyOperation…</FluentText>
                        }
                        else if (PullManager.FindActive(model.Name) is { } updateJob)
                        {
                            <PullProgress Job="updateJob" />
                        }
                        else
                        {
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4px" Width="auto">
                                @if (runningModel is not null)
                                {
                                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="() => UnloadAsync(model.Name)">Unload</FluentButton>
                                }
                                else if (!isCloud)
                                {
                                    <FluentButton Appearance="ButtonAppearance.Outline" Title="@WarmUpTitle" OnClick="() => WarmUpAsync(model.Name)">Warm up</FluentButton>
                                }
                                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="() => PullManager.StartPull(model.Name)">Update</FluentButton>
                                @if (pendingDeletion == model.Name)
                                {
                                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="() => DeleteAsync(model.Name)">Confirm delete</FluentButton>
                                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="CancelDeletion">Cancel</FluentButton>
                                }
                                else
                                {
                                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="() => pendingDeletion = model.Name">Delete</FluentButton>
                                }
                            </FluentStack>
                        }
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16px" Wrap="true">
                        <FluentText Size="TextSize.Size200" Class="muted">@(isCloud ? "runs on ollama.com" : $"{Display.Bytes(model.Size)} on disk")</FluentText>
                        <FluentText Size="TextSize.Size200" Class="muted" Tooltip="@model.ModifiedAt.ToLocalTime().ToString("g", CultureInfo.InvariantCulture)">modified @Display.Relative(model.ModifiedAt.ToLocalTime())</FluentText>
                        @if (runningModel is not null)
                        {
                            <FluentText Size="TextSize.Size200" Class="muted">@Display.MemoryPlacement(runningModel) · unloads @Display.Relative(runningModel.ExpiresAt.ToLocalTime())</FluentText>
                        }
                        <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="() => ToggleDetails(model)">@(modelsShowingDetails.Contains(model.Name) ? "Hide details" : "Show details")</FluentButton>
                    </FluentStack>

                    @if (modelsShowingDetails.Contains(model.Name))
                    {
                        <LocalModelDetails Model="model" />
                    }
                </FluentStack>
            </FluentCard>
        }
    </FluentStack>
}
else if (status.IsReachable)
{
    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="12px">
            <FluentText>No models installed yet.</FluentText>
            <FluentAnchorButton Href="./" Appearance="ButtonAppearance.Primary">Browse the catalog</FluentAnchorButton>
        </FluentStack>
    </FluentCard>
}

@code {
    private string? filterText = "";

    /// <summary>Operation in progress per model, shown in place of its buttons.</summary>
    private readonly Dictionary<string, string> busyOperations = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Model awaiting delete confirmation; a second click is required because deleting cannot be undone.</summary>
    private string? pendingDeletion;

    /// <summary>Models whose details and usage snippets are open.</summary>
    private readonly HashSet<string> modelsShowingDetails = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Failure of the last operation on a model, shown above the list until dismissed.</summary>
    private string? failure;

    protected override void OnInitialized()
    {
        // The installed list and update progress both change the table.
        Watch(handler => StatusMonitor.Changed += handler, handler => StatusMonitor.Changed -= handler);
        Watch(handler => PullManager.Changed += handler, handler => PullManager.Changed -= handler);
    }

    /// <summary>Tooltip of the warm-up button, stating how long the model stays resident.</summary>
    private string WarmUpTitle => $"Load into memory for {OllamaOptions.Value.WarmUpKeepAlive}";

    private Task RefreshAsync() => StatusMonitor.ProbeNowAsync();

    /// <summary>Queues an update for every installed model; each one downloads only its changed layers.</summary>
    private void UpdateAll()
    {
        foreach (Model model in StatusMonitor.Current.LocalModels)
            PullManager.StartPull(model.Name);
    }

    /// <summary>Loads a model into memory for the configured keep-alive, so its first prompt answers without load delay.</summary>
    private Task WarmUpAsync(string modelName)
        => RunAsync(modelName, "Warming up", "warm up", () => OllamaClient.RequestModelLoadAsync(modelName, OllamaOptions.Value.WarmUpKeepAlive));

    /// <summary>Evicts a model from memory through OllamaSharp, freeing RAM and VRAM without deleting it.</summary>
    private Task UnloadAsync(string modelName)
        => RunAsync(modelName, "Unloading", "unload", () => OllamaClient.RequestModelUnloadAsync(modelName));

    /// <summary>Deletes a model after confirmation and refreshes the shared list.</summary>
    private async Task DeleteAsync(string modelName)
    {
        pendingDeletion = null;
        await RunAsync(modelName, "Deleting", "delete", () => OllamaClient.DeleteModelAsync(modelName));
    }

    /// <summary>Opens or closes the details of a model.</summary>
    private void ToggleDetails(Model model)
    {
        // A name already in the set means the details are open, so the click closes them.
        if (!modelsShowingDetails.Remove(model.Name))
            modelsShowingDetails.Add(model.Name);
    }

    private void CancelDeletion() => pendingDeletion = null;

    private void DismissFailure() => failure = null;

    /// <summary>Runs an OllamaSharp operation for a model, showing it as busy and reporting only a failure.</summary>
    private async Task RunAsync(string modelName, string busyLabel, string failedAction, Func<Task> operation)
    {
        // The card shows the label in place of the buttons until the operation ends.
        busyOperations[modelName] = busyLabel;
        try
        {
            await operation();
        }
        catch (Exception operationError)
        {
            // Ollama's own message (model in use, not enough memory...) is the most useful explanation.
            ShowFailure($"Could not {failedAction} {modelName}: {operationError.Message}");
        }
        finally
        {
            busyOperations.Remove(modelName);
        }

        // Residency and the installed list changed: every open tab is refreshed at once.
        await StatusMonitor.ProbeNowAsync();
    }

    /// <summary>Puts a failure message above the list, replacing the previous one.</summary>
    private void ShowFailure(string message) => failure = message;
}
