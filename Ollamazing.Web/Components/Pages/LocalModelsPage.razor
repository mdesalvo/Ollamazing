@page "/models"
@inherits LiveComponentBase
@inject IOllamaApiClient OllamaClient
@inject ServerStatusMonitor StatusMonitor
@inject PullManager PullManager
@inject IOptions<OllamaOptions> OllamaOptions

<PageTitle>Local models · Ollamazing</PageTitle>

@{
    // Installed and resident models come from the shared status probe, so every tab sees the same list.
    ServerStatus status = StatusMonitor.Current;
    Dictionary<string, RunningModel> runningByName = status.RunningModels.ToDictionary(model => model.Name, StringComparer.OrdinalIgnoreCase);
    List<Model> visibleModels = status.LocalModels
        .Where(model => string.IsNullOrEmpty(filterText) || model.Name.Contains(filterText, StringComparison.OrdinalIgnoreCase))
        .ToList();
}

<PageHeader Title="Local models">
    <Subtitle>@status.LocalModels.Count installed · @Display.Bytes(status.LocalModels.Sum(model => model.Size)) on disk · @status.RunningModels.Count loaded in memory</Subtitle>
    <Actions>
        <FluentButton Disabled="@(!status.IsReachable)" OnClick="RefreshAsync">Refresh</FluentButton>
        <FluentButton Disabled="@(!status.IsReachable || status.LocalModels.Count == 0)" OnClick="UpdateAll"
                      Title="Pull every installed model again; only changed layers are downloaded">Update all</FluentButton>
    </Actions>
</PageHeader>

@if (!status.IsReachable && !status.IsInitial)
{
    <FluentMessageBar Intent="MessageBarIntent.Warning" Margin="@Margin.Bottom4">
        Ollama is offline, so installed models cannot be listed. <FluentLink Href="server">Open the server panel</FluentLink>
    </FluentMessageBar>
}
@if (feedback is not null)
{
    <FluentMessageBar Intent="@(feedbackIsError ? MessageBarIntent.Error : MessageBarIntent.Success)" Margin="@Margin.Bottom4">
        <ChildContent>@feedback</ChildContent>
        <ActionsTemplate><FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle" OnClick="DismissFeedback">Dismiss</FluentButton></ActionsTemplate>
    </FluentMessageBar>
}

@if (status.LocalModels.Count > 0)
{
    <FluentTextInput Appearance="TextInputAppearance.FilledDarker" TextInputType="TextInputType.Search" Placeholder="Filter installed models…" Immediate="true" Width="100%"
                     @bind-Value="filterText" AriaLabel="Filter installed models" Margin="@Margin.Bottom4" />

    <FluentCard>
        <FluentDataGrid Items="visibleModels.AsQueryable()" ItemKey="model => model.Name" MultiLine="true" GridTemplateColumns="2fr 1fr 1fr 1fr 1fr 2fr 280px">
            <ChildContent>
                <TemplateColumn Title="Model">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="2px">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6px" VerticalAlignment="VerticalAlignment.Center">
                            <FluentText Weight="TextWeight.Semibold">@context.Name</FluentText>
                            @if (IsCloudModel(context))
                            {
                                <FluentBadge Size="BadgeSize.Small" Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative" Content="cloud" />
                            }
                        </FluentStack>
                        @if (context.Details?.Family is { } family)
                        {
                            <FluentText Size="TextSize.Size200" Class="muted">@family</FluentText>
                        }
                    </FluentStack>
                </TemplateColumn>
                <TemplateColumn Title="Size">@(IsCloudModel(context) ? "–" : Display.Bytes(context.Size))</TemplateColumn>
                <TemplateColumn Title="Parameters">@context.Details?.ParameterSize</TemplateColumn>
                <TemplateColumn Title="Quantization">@context.Details?.QuantizationLevel</TemplateColumn>
                <TemplateColumn Title="Modified">
                    <FluentText Tooltip="@context.ModifiedAt.ToLocalTime().ToString("g")">@Display.Relative(context.ModifiedAt.ToLocalTime())</FluentText>
                </TemplateColumn>
                <TemplateColumn Title="Memory">
                    @if (runningByName.GetValueOrDefault(context.Name) is { } runningModel)
                    {
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2px">
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand" Content="loaded" />
                            <FluentText Size="TextSize.Size200" Class="muted">@Display.Bytes(runningModel.Size) · @GpuShare(runningModel) GPU · unloads @Display.Relative(runningModel.ExpiresAt.ToLocalTime())</FluentText>
                        </FluentStack>
                    }
                    else
                    {
                        <FluentText Class="muted">idle</FluentText>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Actions" Align="DataGridCellAlignment.End">
                    @if (busyOperations.GetValueOrDefault(context.Name) is { } busyOperation)
                    {
                        <FluentText Class="muted">@busyOperation…</FluentText>
                    }
                    else if (PullManager.FindActive(context.Name) is { } updateJob)
                    {
                        <PullProgress Job="updateJob" />
                    }
                    else
                    {
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4px" HorizontalAlignment="HorizontalAlignment.End">
                            @if (runningByName.ContainsKey(context.Name))
                            {
                                <FluentButton Size="ButtonSize.Small" OnClick="() => UnloadAsync(context.Name)">Unload</FluentButton>
                            }
                            else
                            {
                                <FluentButton Size="ButtonSize.Small" Disabled="@IsCloudModel(context)" Title="@WarmUpTitle" OnClick="() => WarmUpAsync(context.Name)">Warm up</FluentButton>
                            }
                            <FluentButton Size="ButtonSize.Small" OnClick="() => PullManager.StartPull(context.Name)">Update</FluentButton>
                            @if (pendingDeletion == context.Name)
                            {
                                <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Primary" OnClick="() => DeleteAsync(context.Name)">Confirm delete</FluentButton>
                                <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Subtle" OnClick="CancelDeletion">Cancel</FluentButton>
                            }
                            else
                            {
                                <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Outline" OnClick="() => pendingDeletion = context.Name">Delete</FluentButton>
                            }
                        </FluentStack>
                    }
                </TemplateColumn>
            </ChildContent>
            <RowDetails>
                <LocalModelDetails Model="context" />
            </RowDetails>
        </FluentDataGrid>
    </FluentCard>
}
else if (status.IsReachable)
{
    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="12px">
            <FluentText>No models installed yet.</FluentText>
            <FluentAnchorButton Href="./" Appearance="ButtonAppearance.Primary">Browse the catalog</FluentAnchorButton>
        </FluentStack>
    </FluentCard>
}

@code {
    private string? filterText = "";

    /// <summary>Operation in progress per model, shown in place of its buttons.</summary>
    private readonly Dictionary<string, string> busyOperations = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Model awaiting delete confirmation; a second click is required because deleting cannot be undone.</summary>
    private string? pendingDeletion;

    private string? feedback;
    private bool feedbackIsError;

    protected override void OnInitialized()
    {
        // The installed list and update progress both change the table.
        Watch(handler => StatusMonitor.Changed += handler, handler => StatusMonitor.Changed -= handler);
        Watch(handler => PullManager.Changed += handler, handler => PullManager.Changed -= handler);
    }

    /// <summary>Cloud models are pointers to ollama.com and have no weights to load locally.</summary>
    private static bool IsCloudModel(Model model)
        => model.Name.EndsWith(":cloud", StringComparison.OrdinalIgnoreCase) || model.Name.EndsWith("-cloud", StringComparison.OrdinalIgnoreCase);

    /// <summary>Share of a loaded model placed on the GPU; the remainder runs on CPU and system RAM.</summary>
    private static string GpuShare(RunningModel runningModel)
        => runningModel.Size > 0 ? $"{runningModel.SizeVram * 100.0 / runningModel.Size:0}%" : "0%";

    /// <summary>Tooltip of the warm-up button, stating how long the model stays resident.</summary>
    private string WarmUpTitle => $"Load into memory for {OllamaOptions.Value.WarmUpKeepAlive}";

    private Task RefreshAsync() => StatusMonitor.ProbeNowAsync();

    /// <summary>Queues an update for every installed model; each one downloads only its changed layers.</summary>
    private void UpdateAll()
    {
        foreach (Model model in StatusMonitor.Current.LocalModels)
            PullManager.StartPull(model.Name);
        ShowFeedback($"Queued updates for {StatusMonitor.Current.LocalModels.Count} models.", isError: false);
    }

    /// <summary>Loads a model into memory for the configured keep-alive, so its first prompt answers without load delay.</summary>
    private Task WarmUpAsync(string modelName)
        => RunAsync(modelName, "Warming up", () => OllamaClient.RequestModelLoadAsync(modelName, OllamaOptions.Value.WarmUpKeepAlive));

    /// <summary>Evicts a model from memory through OllamaSharp, freeing RAM and VRAM without deleting it.</summary>
    private Task UnloadAsync(string modelName)
        => RunAsync(modelName, "Unloading", () => OllamaClient.RequestModelUnloadAsync(modelName));

    /// <summary>Deletes a model after confirmation and refreshes the shared list.</summary>
    private async Task DeleteAsync(string modelName)
    {
        pendingDeletion = null;
        await RunAsync(modelName, "Deleting", () => OllamaClient.DeleteModelAsync(modelName));
    }

    private void CancelDeletion() => pendingDeletion = null;

    private void DismissFeedback() => feedback = null;

    /// <summary>Runs an OllamaSharp operation for a model, showing it as busy and reporting the outcome.</summary>
    private async Task RunAsync(string modelName, string operationName, Func<Task> operation)
    {
        busyOperations[modelName] = operationName;
        try
        {
            await operation();
            ShowFeedback($"{operationName} {modelName}: done.", isError: false);
        }
        catch (Exception operationError)
        {
            // Ollama's own message (model in use, not enough memory...) is the most useful explanation.
            ShowFeedback($"{operationName} {modelName} failed: {operationError.Message}", isError: true);
        }
        finally
        {
            busyOperations.Remove(modelName);
        }

        // Residency and the installed list changed: every open tab is refreshed at once.
        await StatusMonitor.ProbeNowAsync();
    }

    private void ShowFeedback(string message, bool isError)
    {
        feedback = message;
        feedbackIsError = isError;
    }
}
