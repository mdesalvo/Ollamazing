@page "/server"
@inherits LiveComponentBase
@inject ServerStatusMonitor StatusMonitor
@inject OllamaUpdateMonitor UpdateMonitor
@inject OllamaUpdater Updater
@inject OllamaServerController ServerController
@inject IOllamaApiClient OllamaClient
@inject IOptions<OllamaOptions> OllamaOptions
@inject IOptions<ServerControlOptions> ServerControlOptions

<PageTitle>Server · Ollamazing</PageTitle>

@{
    ServerStatus status = StatusMonitor.Current;
    OllamaUpdateStatus update = UpdateMonitor.Current;
}
<PageHeader Title="Ollama server">
    <Subtitle>Checked @Display.Relative(status.CheckedAt)</Subtitle>
</PageHeader>

@* A successful action shows in the status card; only a failure needs its own message. *@
@if (lastResult is { Succeeded: false } && runningAction is null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Title="@($"{lastResult.Action} failed")" Margin="@Margin.Bottom4">
        @lastResult.Message (@Display.Relative(lastResult.ExecutedAt))
    </FluentMessageBar>
}

@if (Updater.Progress is { Stage: UpdateStage.Failed } failedUpdate)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Title="Update failed" Margin="@Margin.Bottom4">@failedUpdate.Error</FluentMessageBar>
}

@if (UpdateMonitor.IsEnabled && update.LastError is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Title="Update check failed" Margin="@Margin.Bottom4">@update.LastError</FluentMessageBar>
}

<FluentCard>
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16px" Wrap="true">
        <FluentPresenceBadge Status="@StatusPresence(status)" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px" Width="auto">
            <FluentText Size="TextSize.Size600" Weight="TextWeight.Semibold">@StatusTitle(status)</FluentText>
            @if (StatusDetail(status) is { } statusDetail)
            {
                <FluentText Class="muted">@statusDetail</FluentText>
            }
            @foreach (string hardwareLine in HardwareLines(status))
            {
                <FluentText Class="muted">@hardwareLine</FluentText>
            }
            @if (IsExternal(status))
            {
                <FluentText Size="TextSize.Size200" Class="muted">Stop or restart it where it was started: the desktop app, a terminal or a system service.</FluentText>
            }
        </FluentStack>
        <FluentSpacer />
        @if (!status.IsInitial && !IsExternal(status))
        {
            <FluentButton Appearance="ButtonAppearance.Primary" Loading="@(runningAction == ServerAction.Start)"
                          Disabled="@(runningAction is not null || IsUpdating || status.Process.IsRunning || status.IsReachable)" OnClick="StartAsync">Start</FluentButton>
            <FluentButton Loading="@(runningAction == ServerAction.Restart)"
                          Disabled="@(runningAction is not null || IsUpdating || !status.Process.IsOwned || !status.IsReachable)" OnClick="RestartAsync">Restart</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" Loading="@(runningAction == ServerAction.Stop)"
                          Disabled="@(runningAction is not null || IsUpdating || !status.Process.IsOwned)" OnClick="StopAsync">Stop</FluentButton>
        }
    </FluentStack>
</FluentCard>

@if (UpdateMonitor.IsEnabled)
{
    <SectionCard Title="Updates" Margin="@Margin.Top4">
        <Actions>
            @if (update.IsUpdateAvailable && update.Capability is { Mode: UpdateMode.InPlace } && Updater.Progress is not { IsRunning: true })
            {
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Updater.Start">Update</FluentButton>
            }
            @if (Updater.Progress is { IsRunning: true, CanCancel: true })
            {
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="Updater.Cancel">Cancel</FluentButton>
            }
        </Actions>
        <ChildContent>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px" HorizontalAlignment="HorizontalAlignment.Stretch">
                @if (Updater.Progress is { IsRunning: true } runningUpdate)
                {
                    <FluentProgressBar Value="@UpdatePercent(runningUpdate)" Max="100" Width="100%" />
                    <FluentText Size="TextSize.Size200" Class="muted">@UpdateStageText(runningUpdate)</FluentText>
                }
                else if (update.InstalledVersion is null)
                {
                    <FluentText Size="TextSize.Size200" Class="muted">Start the server to check for updates</FluentText>
                }
                else if (update.LatestRelease is null)
                {
                    <FluentText Size="TextSize.Size200" Class="muted">Checking…</FluentText>
                }
                else if (update.IsUpdateAvailable)
                {
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px" Wrap="true">
                        <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Warning" Content="@($"{update.LatestRelease.Version} available")" />
                        @if (update.Capability is { } updateCapability && update.LatestRelease.TotalSizeOf(updateCapability.AssetNames) is { } downloadSize)
                        {
                            <FluentText Size="TextSize.Size200" Class="muted">@Display.Bytes(downloadSize)</FluentText>
                        }
                        <FluentLink Href="@update.LatestRelease.Url" Target="LinkTarget.Blank" ReferrerPolicy="LinkReferrerPolicy.NoReferrer">Release notes</FluentLink>
                        @if (update.Capability is { Mode: UpdateMode.InPlace })
                        {
                            <FluentText Size="TextSize.Size200" Class="muted">The server will restart</FluentText>
                        }
                    </FluentStack>
                    @if (update.Capability is { Mode: UpdateMode.NotifyOnly } notifyCapability)
                    {
                        <FluentText Size="TextSize.Size200" Class="muted">@notifyCapability.Reason <FluentLink Href="https://ollama.com/download" Target="LinkTarget.Blank" ReferrerPolicy="LinkReferrerPolicy.NoReferrer">Download</FluentLink></FluentText>
                    }
                }
                else
                {
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px" Wrap="true">
                        <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Content="up to date" />
                        @if (update.CheckedAt is { } updateCheckedAt)
                        {
                            <FluentText Size="TextSize.Size200" Class="muted">@Display.Relative(updateCheckedAt)</FluentText>
                        }
                    </FluentStack>
                }
            </FluentStack>
        </ChildContent>
    </SectionCard>
}

<FluentGrid Spacing="3" Margin="@Margin.Top4">
    <FluentGridItem Xs="12" Sm="6">
        <StatCard Label="In memory" Value="@Display.Quantity(status.RunningModels.Count, "model")" Detail="@MemoryTotals(status)" />
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6">
        <StatCard Label="Installed" Value="@Display.Quantity(status.LocalModels.Count, "model")" Detail="@($"{Display.Bytes(status.LocalDiskBytes)} on disk")" />
    </FluentGridItem>
</FluentGrid>

<SectionCard Title="Loaded models" Margin="@Margin.Top4">
    @if (unloadFailure is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">@unloadFailure</FluentMessageBar>
    }
    @if (status.RunningModels.Count == 0)
    {
        <FluentText Class="muted">No model is loaded. <FluentLink Href="models">Warm one up from Local models</FluentLink></FluentText>
    }
    else
    {
        <FluentDataGrid Items="status.RunningModels.AsQueryable()" GridTemplateColumns="2fr 2fr 1fr 120px">
            <TemplateColumn Title="Model">@context.Name</TemplateColumn>
            <TemplateColumn Title="Memory">@Display.MemoryPlacement(context)</TemplateColumn>
            <TemplateColumn Title="Unloads">@Display.Relative(context.ExpiresAt.ToLocalTime())</TemplateColumn>
            <TemplateColumn Title="" Align="DataGridCellAlignment.End">
                <FluentButton Size="ButtonSize.Small" Loading="@unloadingModels.Contains(context.Name)" OnClick="() => UnloadAsync(context.Name)">Unload</FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
    }
</SectionCard>

<FluentAccordion ExpandMode="AccordionExpandMode.Multi" Margin="@Margin.Top4">
    <FluentAccordionItem Header="Server log">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px">
                <FluentCheckbox Label="Follow" @bind-Value="followLog" />
                <FluentButton Size="ButtonSize.Small" OnClick="LoadLogAsync">Refresh</FluentButton>
            </FluentStack>
            <FluentText As="TextTag.Pre" Font="TextFont.Monospace" Size="TextSize.Size200" Style="max-height: 28rem; overflow: auto; margin: 0;">@(serverLog ?? "Loading…")</FluentText>
        </FluentStack>
    </FluentAccordionItem>
    <FluentAccordionItem Header="Settings">
        <FluentGrid Spacing="2">
            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">API address</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9"><FluentText Font="TextFont.Monospace">@OllamaOptions.Value.BaseUrl</FluentText></FluentGridItem>

            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">Executable</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9"><FluentText Font="TextFont.Monospace">@ServerControlOptions.Value.ExecutablePath serve</FluentText></FluentGridItem>

            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">Start on launch</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9"><FluentText>@(ServerControlOptions.Value.StartOnLaunch ? "yes" : "no")</FluentText></FluentGridItem>

            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">Stop on exit</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9"><FluentText>@(ServerControlOptions.Value.StopOnExit ? "yes, if started by Ollamazing" : "no")</FluentText></FluentGridItem>

            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">Environment</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9">
                @if (ServerControlOptions.Value.Environment.Count == 0)
                {
                    <FluentText Class="muted">defaults</FluentText>
                }
                @foreach ((string variableName, string variableValue) in ServerControlOptions.Value.Environment)
                {
                    <FluentText Font="TextFont.Monospace" Block="true">@variableName=@variableValue</FluentText>
                }
            </FluentGridItem>
        </FluentGrid>
        <FluentText Size="TextSize.Size200" Class="muted">Edit the Ollama and ServerControl sections of appsettings.json to change these values.</FluentText>
    </FluentAccordionItem>
</FluentAccordion>

@code {
    /// <summary>Lifecycle action in progress; its button shows a progress ring and the others are disabled.</summary>
    private ServerAction? runningAction;

    /// <summary>Outcome of the latest lifecycle action; a failure is shown in a message bar.</summary>
    private ServerActionResult? lastResult;

    /// <summary>Tail of the Ollama server log shown in the accordion; null until the first load.</summary>
    private string? serverLog;

    /// <summary>When set, the log is reloaded at every status probe.</summary>
    private bool followLog;

    /// <summary>Last unload error, shown in the loaded models section.</summary>
    private string? unloadFailure;

    /// <summary>Models whose unload request is in flight; their buttons show a progress ring.</summary>
    private readonly HashSet<string> unloadingModels = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>True while an in-place update runs, since the server then must not be started or stopped by hand.</summary>
    private bool IsUpdating =>
        // The update swaps the installation under the server and restarts it by itself.
        Updater.Progress is { IsRunning: true };

    /// <summary>Subscribes the page to every monitor and loads the first log tail.</summary>
    protected override async Task OnInitializedAsync()
    {
        // Every probe updates the cards; the log follows only on request.
        Watch(handler => StatusMonitor.Changed += handler, handler => StatusMonitor.Changed -= handler);
        Watch(handler => UpdateMonitor.Changed += handler, handler => UpdateMonitor.Changed -= handler);
        Watch(handler => Updater.Changed += handler, handler => Updater.Changed -= handler);
        Watch(handler => StatusMonitor.Changed += handler, handler => StatusMonitor.Changed -= handler, ReloadLogWhenFollowing);

        // The accordion shows the log as soon as it is opened.
        await LoadLogAsync();
    }

    /// <summary>Reloads the log after a probe while "Follow" is checked.</summary>
    private void ReloadLogWhenFollowing()
    {
        // Probes arrive on a background thread, so the reload is marshalled onto the circuit.
        if (followLog)
            _ = InvokeAsync(LoadLogAsync);
    }

    /// <summary>Replaces the shown log with the latest lines of the server.</summary>
    private async Task LoadLogAsync()
    {
        // The controller reads the log of the server that Ollamazing or the configuration points to.
        serverLog = await ServerController.GetLogsAsync();

        // The call can come from a probe handler, so the new text is rendered explicitly.
        StateHasChanged();
    }

    /// <summary>Runs a lifecycle action off the circuit thread, since stopping waits for the process to exit.</summary>
    private async Task ExecuteAsync(ServerAction action)
    {
        // The running action disables the buttons and animates its own.
        runningAction = action;

        // The outcome is kept so a failure can be reported in the message bar.
        lastResult = await Task.Run(() => ServerController.Execute(action));

        // The buttons are usable again whatever the outcome.
        runningAction = null;

        // The new state is published right away instead of at the next poll.
        await StatusMonitor.ProbeNowAsync();

        // The log now shows what the action printed.
        await LoadLogAsync();
    }

    /// <summary>The hardware Ollama runs models on, one line per device.</summary>
    private static IEnumerable<string> HardwareLines(ServerStatus status)
    {
        // Before the first probe nothing is known and nothing is claimed.
        if (status.IsInitial)
            return [];

        // Unknown hardware matters only while the server is up, since a stopped one has nothing to explain.
        if (status.ComputeDevices is null)
            return status.IsReachable ? [Display.HardwareUnknown] : [];

        // With a GPU each accelerator is listed, since the processor memory is not the budget.
        if (status.HasGpu)
            return status.ComputeDevices.Where(device => device.IsGpu).Select(device => $"{device.Name} · {device.Library} · {Display.Bytes(device.TotalBytes)}");

        // Without a GPU the models run on the processor and its RAM.
        return [$"CPU only · {Display.Bytes(status.InferenceMemoryBytes)}"];
    }

    /// <summary>Percentage of the whole download or unpacking that is done; null when the bar cannot be determinate.</summary>
    private static int? UpdatePercent(UpdateProgress progress) =>
        // Only the two byte-counting stages have a total to divide by.
        progress.BytesTotal is > 0 && progress.Stage is UpdateStage.Downloading or UpdateStage.Extracting
            ? (int)(progress.BytesDone * 100 / progress.BytesTotal.Value)
            : null;

    /// <summary>Plain-words description of what the running update is doing.</summary>
    private static string UpdateStageText(UpdateProgress progress) => progress.Stage switch
    {
        // The size is shown only when it is known.
        UpdateStage.Downloading => progress.BytesTotal is { } bytesTotal
            ? $"Downloading (Version {progress.Version}) · {Display.Bytes(progress.BytesDone)} of {Display.Bytes(bytesTotal)}"
            : $"Downloading (Version {progress.Version}) · {Display.Bytes(progress.BytesDone)}",
        // The downloaded files are being unpacked.
        UpdateStage.Extracting => $"Unpacking (Version {progress.Version})",
        // The files are being swapped.
        UpdateStage.Installing => $"Installing (Version {progress.Version})",
        // The server is coming back on the new version.
        UpdateStage.Restarting => $"Restarting (Version {progress.Version})",
        // The other stages show no progress.
        _ => ""
    };

    /// <summary>Starts the Ollama server as a child of Ollamazing.</summary>
    private Task StartAsync() => ExecuteAsync(ServerAction.Start);

    /// <summary>Stops and starts again the server that Ollamazing owns.</summary>
    private Task RestartAsync() => ExecuteAsync(ServerAction.Restart);

    /// <summary>Stops the server that Ollamazing owns.</summary>
    private Task StopAsync() => ExecuteAsync(ServerAction.Stop);

    /// <summary>True when the server runs but was started outside Ollamazing, which then cannot stop or restart it.</summary>
    private static bool IsExternal(ServerStatus status) =>
        // A live server without an owned process was started elsewhere.
        !status.Process.IsOwned && (status.IsReachable || status.Process.IsRunning);

    /// <summary>Headline of the status card: whether Ollama can be used right now.</summary>
    private static string StatusTitle(ServerStatus status) => status switch
    {
        // The first probe has not answered yet.
        { IsInitial: true } => "Checking Ollama…",
        // The API answers, so every page works.
        { IsReachable: true } => "Ollama is running",
        // The process exists but the API is still silent, typically while it starts.
        { Process.IsRunning: true } => "Ollama is starting…",
        // Nothing runs.
        _ => "Ollama is stopped"
    };

    /// <summary>Colour of the status dot, following the headline.</summary>
    private static PresenceStatus StatusPresence(ServerStatus status) => status switch
    {
        // The state is not known before the first probe.
        { IsInitial: true } => PresenceStatus.Unknown,
        // Green: the API answers.
        { IsReachable: true } => PresenceStatus.Available,
        // Amber: the server is on its way up.
        { Process.IsRunning: true } => PresenceStatus.Away,
        // Red: nothing runs.
        _ => PresenceStatus.Busy
    };

    /// <summary>Version, uptime and origin of the server in plain words; null when nothing about it is known.</summary>
    private static string? StatusDetail(ServerStatus status)
    {
        // Each fact appears only when the server discloses it.
        List<string> facts = [];
        if (status.Version is { } version)
            facts.Add($"Version {version}");
        if (status.Process.RunningSince is { } runningSince)
            facts.Add($"up for {Display.Duration(DateTimeOffset.Now - runningSince)}");

        // Who started the server decides which actions the card offers.
        if (status.Process.IsOwned)
            facts.Add("started by Ollamazing");
        else if (IsExternal(status))
            facts.Add("started outside Ollamazing");

        // Nothing known yields null so the card shows no empty line.
        return facts.Count > 0 ? string.Join(" · ", facts) : null;
    }

    /// <summary>Memory taken by the loaded models, with the share on the GPU only when there is one.</summary>
    private static string MemoryTotals(ServerStatus status)
    {
        // Total memory and the part of it held in video memory.
        long totalBytes = status.RunningModels.Sum(model => model.Size);
        long gpuBytes = status.RunningModels.Sum(model => model.SizeVram);

        // The GPU share is mentioned only when some model actually uses video memory.
        return gpuBytes > 0 ? $"{Display.Bytes(totalBytes)} · {Display.Bytes(gpuBytes)} on GPU" : Display.Bytes(totalBytes);
    }

    /// <summary>Evicts a model from memory through OllamaSharp.</summary>
    private async Task UnloadAsync(string modelName)
    {
        // The button of this row shows its progress ring and a previous failure is dismissed.
        unloadingModels.Add(modelName);
        unloadFailure = null;
        try
        {
            // A zero keep-alive makes Ollama drop the model from memory.
            await OllamaClient.RequestModelUnloadAsync(modelName);
        }
        catch (Exception unloadError)
        {
            // The failure is shown above the table of loaded models.
            unloadFailure = $"Unloading {modelName} failed: {unloadError.Message}";
        }
        finally
        {
            // The button is released whether the unload worked or not.
            unloadingModels.Remove(modelName);
        }

        // The loaded-models table reflects the eviction right away instead of at the next poll.
        await StatusMonitor.ProbeNowAsync();
    }
}
