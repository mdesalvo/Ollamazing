@page "/server"
@inherits LiveComponentBase
@inject ServerStatusMonitor StatusMonitor
@inject OllamaServerController ServerController
@inject IOllamaApiClient OllamaClient
@inject IOptions<OllamaOptions> OllamaOptions
@inject IOptions<ServerControlOptions> ServerControlOptions

<PageTitle>Server · Ollamazing</PageTitle>

@{
    ServerStatus status = StatusMonitor.Current;
}
<PageHeader Title="Ollama server">
    <Subtitle>Checked @Display.Relative(status.CheckedAt)</Subtitle>
</PageHeader>

@* A successful action shows in the status card; only a failure needs its own message. *@
@if (lastResult is { Succeeded: false } && runningAction is null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Title="@($"{lastResult.Action} failed")" Margin="@Margin.Bottom4">
        @lastResult.Message (@Display.Relative(lastResult.ExecutedAt))
    </FluentMessageBar>
}

<FluentCard>
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16px" Wrap="true">
        <FluentPresenceBadge Status="@StatusPresence(status)" />
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px" Width="auto">
            <FluentText Size="TextSize.Size600" Weight="TextWeight.Semibold">@StatusTitle(status)</FluentText>
            @if (StatusDetail(status) is { } statusDetail)
            {
                <FluentText Class="muted">@statusDetail</FluentText>
            }
            @if (IsExternal(status))
            {
                <FluentText Size="TextSize.Size200" Class="muted">Stop or restart it where it was started: the desktop app, a terminal or a system service.</FluentText>
            }
        </FluentStack>
        <FluentSpacer />
        @if (!status.IsInitial && !IsExternal(status))
        {
            <FluentButton Appearance="ButtonAppearance.Primary" Loading="@(runningAction == ServerAction.Start)"
                          Disabled="@(runningAction is not null || status.Process.IsRunning || status.IsReachable)" OnClick="StartAsync">Start</FluentButton>
            <FluentButton Loading="@(runningAction == ServerAction.Restart)"
                          Disabled="@(runningAction is not null || !status.Process.IsOwned || !status.IsReachable)" OnClick="RestartAsync">Restart</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" Loading="@(runningAction == ServerAction.Stop)"
                          Disabled="@(runningAction is not null || !status.Process.IsOwned)" OnClick="StopAsync">Stop</FluentButton>
        }
    </FluentStack>
</FluentCard>

<FluentGrid Spacing="3" Margin="@Margin.Top4">
    <FluentGridItem Xs="12" Sm="6">
        <StatCard Label="In memory" Value="@ModelCount(status.RunningModels.Count)" Detail="@MemoryTotals(status)" />
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6">
        <StatCard Label="Installed" Value="@ModelCount(status.LocalModels.Count)" Detail="@($"{Display.Bytes(status.LocalModels.Where(model => !model.IsCloud()).Sum(model => model.Size))} on disk")" />
    </FluentGridItem>
</FluentGrid>

<SectionCard Title="Loaded models" Margin="@Margin.Top4">
    @if (unloadFailure is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">@unloadFailure</FluentMessageBar>
    }
    @if (status.RunningModels.Count == 0)
    {
        <FluentText Class="muted">No model is loaded. <FluentLink Href="models">Warm one up from Local models</FluentLink></FluentText>
    }
    else
    {
        <FluentDataGrid Items="status.RunningModels.AsQueryable()" GridTemplateColumns="2fr 2fr 1fr 120px">
            <TemplateColumn Title="Model">@context.Name</TemplateColumn>
            <TemplateColumn Title="Memory">@Display.MemoryPlacement(context)</TemplateColumn>
            <TemplateColumn Title="Unloads">@Display.Relative(context.ExpiresAt.ToLocalTime())</TemplateColumn>
            <TemplateColumn Title="" Align="DataGridCellAlignment.End">
                <FluentButton Size="ButtonSize.Small" Loading="@unloadingModels.Contains(context.Name)" OnClick="() => UnloadAsync(context.Name)">Unload</FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
    }
</SectionCard>

<FluentAccordion ExpandMode="AccordionExpandMode.Multi" Margin="@Margin.Top4">
    <FluentAccordionItem Header="Server log">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8px">
                <FluentCheckbox Label="Follow" @bind-Value="followLog" />
                <FluentButton Size="ButtonSize.Small" OnClick="LoadLogAsync">Refresh</FluentButton>
            </FluentStack>
            <FluentText As="TextTag.Pre" Font="TextFont.Monospace" Size="TextSize.Size200" Style="max-height: 28rem; overflow: auto; margin: 0;">@(serverLog ?? "Loading…")</FluentText>
        </FluentStack>
    </FluentAccordionItem>
    <FluentAccordionItem Header="Settings">
        <FluentGrid Spacing="2">
            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">API address</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9"><FluentText Font="TextFont.Monospace">@OllamaOptions.Value.BaseUrl</FluentText></FluentGridItem>

            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">Executable</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9"><FluentText Font="TextFont.Monospace">@ServerControlOptions.Value.ExecutablePath serve</FluentText></FluentGridItem>

            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">Start on launch</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9"><FluentText>@(ServerControlOptions.Value.StartOnLaunch ? "yes" : "no")</FluentText></FluentGridItem>

            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">Stop on exit</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9"><FluentText>@(ServerControlOptions.Value.StopOnExit ? "yes, if started by Ollamazing" : "no")</FluentText></FluentGridItem>

            <FluentGridItem Xs="12" Sm="3"><FluentText Class="muted">Environment</FluentText></FluentGridItem>
            <FluentGridItem Xs="12" Sm="9">
                @if (ServerControlOptions.Value.Environment.Count == 0)
                {
                    <FluentText Class="muted">defaults</FluentText>
                }
                @foreach ((string variableName, string variableValue) in ServerControlOptions.Value.Environment)
                {
                    <FluentText Font="TextFont.Monospace" Block="true">@variableName=@variableValue</FluentText>
                }
            </FluentGridItem>
        </FluentGrid>
        <FluentText Size="TextSize.Size200" Class="muted">Edit the Ollama and ServerControl sections of appsettings.json to change these values.</FluentText>
    </FluentAccordionItem>
</FluentAccordion>

@code {
    /// <summary>Lifecycle action in progress; its button shows a progress ring and the others are disabled.</summary>
    private ServerAction? runningAction;

    private ServerActionResult? lastResult;
    private string? serverLog;

    /// <summary>When set, the log is reloaded at every status probe.</summary>
    private bool followLog;

    /// <summary>Last unload error, shown in the loaded models section.</summary>
    private string? unloadFailure;

    private readonly HashSet<string> unloadingModels = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        // Every probe updates the cards; the log follows only on request.
        Watch(handler => StatusMonitor.Changed += handler, handler => StatusMonitor.Changed -= handler);
        StatusMonitor.Changed += ReloadLogWhenFollowing;
        await LoadLogAsync();
    }

    public override void Dispose()
    {
        StatusMonitor.Changed -= ReloadLogWhenFollowing;
        base.Dispose();
    }

    /// <summary>Reloads the log after a probe while "Follow" is checked.</summary>
    private void ReloadLogWhenFollowing()
    {
        if (followLog)
            _ = InvokeAsync(LoadLogAsync);
    }

    private async Task LoadLogAsync()
    {
        serverLog = await ServerController.GetLogsAsync();
        StateHasChanged();
    }

    /// <summary>Runs a lifecycle action off the circuit thread, since stopping waits for the process to exit.</summary>
    private async Task ExecuteAsync(ServerAction action)
    {
        runningAction = action;
        lastResult = await Task.Run(() => ServerController.Execute(action));
        runningAction = null;

        // The new state is published right away instead of at the next poll.
        await StatusMonitor.ProbeNowAsync();
        await LoadLogAsync();
    }

    private Task StartAsync() => ExecuteAsync(ServerAction.Start);

    private Task RestartAsync() => ExecuteAsync(ServerAction.Restart);

    private Task StopAsync() => ExecuteAsync(ServerAction.Stop);

    /// <summary>A count of models with the noun agreeing, as in "1 model" or "3 models".</summary>
    private static string ModelCount(int count) => count == 1 ? "1 model" : $"{count} models";

    /// <summary>True when the server runs but was started outside Ollamazing, which then cannot stop or restart it.</summary>
    private static bool IsExternal(ServerStatus status) => !status.Process.IsOwned && (status.IsReachable || status.Process.IsRunning);

    /// <summary>Headline of the status card: whether Ollama can be used right now.</summary>
    private static string StatusTitle(ServerStatus status) => status switch
    {
        // The first probe has not answered yet.
        { IsInitial: true } => "Checking Ollama…",
        // The API answers, so every page works.
        { IsReachable: true } => "Ollama is running",
        // The process exists but the API is still silent, typically while it starts.
        { Process.IsRunning: true } => "Ollama is starting…",
        // Nothing runs.
        _ => "Ollama is stopped"
    };

    /// <summary>Colour of the status dot, following the headline.</summary>
    private static PresenceStatus StatusPresence(ServerStatus status) => status switch
    {
        // The state is not known before the first probe.
        { IsInitial: true } => PresenceStatus.Unknown,
        // Green: the API answers.
        { IsReachable: true } => PresenceStatus.Available,
        // Amber: the server is on its way up.
        { Process.IsRunning: true } => PresenceStatus.Away,
        // Red: nothing runs.
        _ => PresenceStatus.Busy
    };

    /// <summary>Version, uptime and origin of the server in plain words; null when nothing about it is known.</summary>
    private static string? StatusDetail(ServerStatus status)
    {
        // Each fact appears only when the server discloses it.
        List<string> facts = [];
        if (status.Version is { } version)
            facts.Add($"Version {version}");
        if (status.Process.RunningSince is { } runningSince)
            facts.Add($"up for {Display.Duration(DateTimeOffset.Now - runningSince)}");

        // Who started the server decides which actions the card offers.
        if (status.Process.IsOwned)
            facts.Add("started by Ollamazing");
        else if (IsExternal(status))
            facts.Add("started outside Ollamazing");

        return facts.Count > 0 ? string.Join(" · ", facts) : null;
    }

    /// <summary>Memory taken by the loaded models, with the share on the GPU only when there is one.</summary>
    private static string MemoryTotals(ServerStatus status)
    {
        long totalBytes = status.RunningModels.Sum(model => model.Size);
        long gpuBytes = status.RunningModels.Sum(model => model.SizeVram);
        return gpuBytes > 0 ? $"{Display.Bytes(totalBytes)} · {Display.Bytes(gpuBytes)} on GPU" : Display.Bytes(totalBytes);
    }

    /// <summary>Evicts a model from memory through OllamaSharp.</summary>
    private async Task UnloadAsync(string modelName)
    {
        unloadingModels.Add(modelName);
        unloadFailure = null;
        try
        {
            await OllamaClient.RequestModelUnloadAsync(modelName);
        }
        catch (Exception unloadError)
        {
            // The failure is shown above the table of loaded models.
            unloadFailure = $"Unloading {modelName} failed: {unloadError.Message}";
        }
        finally
        {
            unloadingModels.Remove(modelName);
        }
        await StatusMonitor.ProbeNowAsync();
    }
}
