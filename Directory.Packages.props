<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <!-- Ollamazing.Server -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.*" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
  </ItemGroup>

  <!-- Ollamazing.Web -->
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.8.*" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.*" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.*" />
  </ItemGroup>

</Project>
